# AX6 NSS Build Lock — Phase 1: qca-nss built-in (no external NSS feed needed)
SOURCE_REPO=https://github.com/OrdinaryJoys/immortalwrt-nss.git
SOURCE_TRACKING_BRANCH=codex/ax6-rps-device-discovery-20260814
SOURCE_BASE_COMMIT=56807d9661dbe7df421d1fd31feba76677b5703d
SOURCE_COMMIT=14f713a2a1e623cdd40b0bb50030ad09a2cf6fb0
SOURCE_PATCHSET_MANIFEST_SHA256=493e22eae3cc8f27aa5918c040c65185b90a6e3ee4a18978d77cafca5ca7ca35
# Package release single source of truth (must match locked source Makefiles)
SOURCE_HOSTAPD_PKG_RELEASE=2
SOURCE_QCA_NSS_DRV_PKG_RELEASE=20
SOURCE_QCA_NSS_ECM_PKG_RELEASE=10
SOURCE_QCA_NSS_CLIENTS_PKG_RELEASE=14
SOURCE_QCA_MCS_PKG_RELEASE=3
# NSS packages now in source tree: package/qca-nss/ (73 files, 10 packages)

SQM_SCRIPTS_NSS_URL=https://github.com/qosmio/sqm-scripts-nss.git
SQM_SCRIPTS_NSS_COMMIT=4b4ed8639229be5e70cf94b73cdf7dbc09e66d5d

# Linear OrdinaryJoys candidate based on ImmortalWrt LuCI 8c4171bcc8. The
# reviewed local theme override is separate from generated Argon CSS; AX6 also
# locks the standalone theme below and applies the same sizing in diy.sh.
LUCI_FEED_URL=https://github.com/OrdinaryJoys/luci.git
LUCI_FEED_TRACKING_BRANCH=codex/luci-upstream-linear-20260811
LUCI_FEED_COMMIT=1bd7a996179baa5b13bcac09d1fc045d7195dc19
PACKAGES_FEED_URL=https://github.com/immortalwrt/packages.git
# Compatibility lock for the current 6.18/NSS source tree. Newer packages
# revisions currently introduce global Kconfig cycles through trafficshaper
# (2e945de2) and freeradius3 (71223e9e); do not advance this lock until the
# complete feed passes defconfig. The authenticated cgi-io security fix is
# applied independently by AX6-IPQ/diy.sh and guarded by fixtures.
PACKAGES_FEED_COMMIT=4db836e2d929b5f0d858000f99aa55bb0ab85100
PACKAGES_FEED_POLICY=compatible-security-backport
CGI_IO_SECURITY_BACKPORT_COMMIT=50dec501ab1bc86f844de2e40d4e4d0aaa613d20
ROUTING_FEED_URL=https://github.com/openwrt/routing.git
ROUTING_FEED_COMMIT=b40e6284f9944b8f3dc2b0edd2319d0c74660fd5
TELEPHONY_FEED_URL=https://github.com/openwrt/telephony.git
TELEPHONY_FEED_COMMIT=5d68d53c160a325ea9d03fce393e051573bcc736
VIDEO_FEED_URL=https://github.com/openwrt/video.git
VIDEO_FEED_COMMIT=a951381b6c58b9b1eb087f09c9a20cff4ffe8063

ARGON_THEME_URL=https://github.com/jerrykuku/luci-theme-argon.git
ARGON_THEME_COMMIT=86c3156bab0ee2b8c91af68b3fa4655f2df51d09
