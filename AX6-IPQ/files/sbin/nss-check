#!/bin/sh
# AX6 NSS / hardware health check
# 用法:
#   nss-check        简洁(只列 FAIL)
#   nss-check -v     详细(全部检查)
#   nss-check -q     静默,只输出 0/N 退出码(适合 cron)
# 退出码 = FAIL 数

VERBOSE=0
QUIET=0

case "${1:-}" in
    ""|"--")
        ;;
    -v|--verbose)
        VERBOSE=1
        ;;
    -q|--quiet)
        QUIET=1
        ;;
    -h|--help)
        sed -n '2,7p' "$0" | sed 's/^# //; s/^#//'
        exit 0
        ;;
    *)
        echo "nss-check: unknown option '$1' (use -v / -q / -h)" >&2
        exit 64
        ;;
esac

PASS=0
FAIL=0
WARN=0

ok() {
    PASS=$((PASS + 1))
    if [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ]; then
        echo " ✓ $1"
    fi
}

fail() {
    FAIL=$((FAIL + 1))
    if [ "$QUIET" -eq 0 ]; then
        echo " ✗ $1"
    fi
}

warn() {
    WARN=$((WARN + 1))
    if [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ]; then
        echo " ! $1"
    fi
}

if [ "$QUIET" -eq 0 ]; then
    echo "=== AX6 NSS / WiFi 健康自检 ==="
fi

# ---- 1. RAM ----
mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null)
if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 800000 ] 2>/dev/null; then
    ok "RAM detected: ${mem_kb} kB (1GB SKU)"
elif [ -n "$mem_kb" ] && [ "$mem_kb" -gt 400000 ] 2>/dev/null; then
    ok "RAM detected: ${mem_kb} kB (512MB stock SKU)"
else
    fail "RAM only ${mem_kb:-?} kB; expected a 512MB or 1GB AX6 SKU"
fi

# ---- 2. NAND 布局 ----
rootfs_size=$(awk '$4 == "\"rootfs\"" {print $2}' /proc/mtd 2>/dev/null)
rootfs1_size=$(awk '$4 == "\"rootfs_1\"" {print $2}' /proc/mtd 2>/dev/null)
overlay_size=$(awk '$4 == "\"overlay\"" {print $2}' /proc/mtd 2>/dev/null)
case "${rootfs_size}:${rootfs1_size}:${overlay_size}" in
    023[cC]0000:023[cC]0000:01[eE][cC]0000)
        warn "NAND layout: Xiaomi original dual-slot (35.75 MiB each); full merged-layout image is not compatible"
        ;;
    0[Cc]000000::)
        ok "NAND layout: expanded 192 MiB rootfs (modded NAND)"
        ;;
    06640000::*)
        ok "NAND layout: SMEM/custom U-Boot merged rootfs (102.25 MiB)"
        ;;
    *)
        warn "NAND layout is non-standard: rootfs=0x${rootfs_size:-?}, rootfs_1=0x${rootfs1_size:-none}, overlay=0x${overlay_size:-none}"
        ;;
esac

# ---- 3. NSS 核心模块加载 ----
# 可选的隧道/协议模块数量会随配置变化，不能用 qca_nss* 总数判断核心状态。
nss_core_missing=""
for nss_core_module in qca_nss_drv qca_nss_dp qca_ssdk ecm; do
    if ! lsmod | awk -v module="$nss_core_module" '$1 == module { found=1 } END { exit !found }'; then
        nss_core_missing="${nss_core_missing}${nss_core_missing:+,}${nss_core_module}"
    fi
done
if [ -z "$nss_core_missing" ]; then
    ok "NSS core modules loaded: qca_nss_drv,qca_nss_dp,qca_ssdk,ecm"
else
    fail "Missing NSS core modules: $nss_core_missing"
fi

# ---- 4. NSS Core 启动 ----
_dmesg=$(dmesg 2>/dev/null)
if echo "$_dmesg" |
    grep -qE 'OF: /soc@0/dp[2-5]@3a001[2468]00: could not find phandle'; then
    fail "AX6 Ethernet DTS has dangling nvmem phandles after bootloader/SMEM fixup"
else
    ok "AX6 Ethernet DTS has no dangling nvmem phandles"
fi
if echo "$_dmesg" | grep -q "NSS core .* booted"; then
    cores=$(echo "$_dmesg" | grep -c "NSS core .* booted")
    ok "NSS Core(s) booted: $cores"
else
    fail "NSS Core 未启动 — 查 dmesg | grep -i 'nss\\|ubi32'"
fi

# ---- 5. NSS clock auto_scale 锁定 ----
auto_scale=$(sysctl -n dev.nss.clock.auto_scale 2>/dev/null)
if [ "$auto_scale" = "0" ]; then
    ok "NSS clock auto_scale = 0 (locked at max)"
else
    warn "NSS clock auto_scale = ${auto_scale:-unset}"
fi

# ---- 6. ath11k 加载 ----
if lsmod | grep -q ath11k; then
    ok "ath11k driver loaded"
else
    fail "ath11k driver 未加载"
fi

# ---- 7. ath11k board file 加载 ----
# board_id 0xff = generic calibration (大多数 IPQ8074 设备)
# 部分固件使用 board_id 0x0..0xfe 的特定校准文件
if echo "$_dmesg" | grep -qE "ath11k.*board_id 0x[0-9a-fA-F]+"; then
    board_id=$(echo "$_dmesg" | grep -oE "board_id 0x[0-9a-fA-F]+" | tail -n 1)
    ok "ath11k board file loaded (${board_id})"
else
    warn "未在 dmesg 找到 ath11k board_id"
fi

# ---- 8. ath11k fw memory mode ----
# AX6 512MB/1GB SKU 均使用 MID 模式 (mode=1):
#   FULL (mode=0) 需要 ~100MB DMA 连续内存,CMA 不足时固件加载失败 → 内核 panic
#   MID (mode=1) ~32MB 内存占用,稳定且性能足够家用 4×4 MU-MIMO 场景
# (dmesg 格式 "FW memory mode: N")
fw_mode=$(echo "$_dmesg" | grep -oE "FW memory mode:[[:space:]]*[0-9]+" | tail -n 1 | grep -oE "[0-9]+")
case "$fw_mode" in
    1)
        ok "ath11k fw_mem_mode = 1 (MID, 与 DTS qcom,ath11k-fw-memory-mode=<1> 匹配)"
        ;;
    0)
        warn "ath11k fw_mem_mode = 0 (FULL/HIGH; 期望 1=MID,可能 CMA 不足时仍能跑)"
        ;;
    2)
        fail "ath11k fw_mem_mode = 2 (LOW); 期望 1=MID,启动序列异常"
        ;;
    "")
        warn "未读到 fw_mem_mode"
        ;;
    *)
        warn "ath11k fw_mem_mode = $fw_mode (期望 1=MID)"
        ;;
esac

# ---- 9. 防火墙 flow_offload 配置和冲突模块必须关 ----
flow_offloading=$(uci -q get firewall.@defaults[0].flow_offloading)
flow_offloading_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
if [ "$flow_offloading" = "1" ] || [ "$flow_offloading_hw" = "1" ]; then
    fail "firewall flow_offloading=${flow_offloading:-unset}, flow_offloading_hw=${flow_offloading_hw:-unset}; NSS ECM 模式应均为 0"
else
    ok "firewall UCI flow offload disabled (NSS ECM handles offload)"
fi
if lsmod | grep -Eq '^(nf_flow_table|nft_flow_offload|ipt_FLOWOFFLOAD) ' 2>/dev/null; then
    fail "Conflicting flow-offload kernel module loaded — rmmod + check /etc/modprobe.d/nss-no-flow.conf"
else
    ok "No conflicting flow-offload kernel modules (NSS ECM handles offload)"
fi

# ---- 10. ECM connection_count ----
# ECM 追踪经过 NSS 的连接，空载时为 0 是正常的
ecm_path="/sys/kernel/debug/ecm/ecm_db/connection_count_simple"
if [ -r "$ecm_path" ]; then
    cc=$(cat "$ecm_path")
    # 提取数字部分 (格式: "tcp N udp M other O total T")
    total=$(echo "$cc" | grep -oE '[0-9]+' | tail -n 1)
    ok "ECM total_connections = ${total:-0} (NSS ECM 计数器正常)"
else
    warn "ECM debugfs 不可读($ecm_path — 是否 mounted?)"
fi

# ---- 11. WiFi 工作模式 ----
if iw dev 2>/dev/null | grep -qE "channel.*MHz.*width: (80|160)"; then
    ok "WiFi 5G HE80/HE160 active"
elif iw dev 2>/dev/null | grep -q "channel.*MHz"; then
    warn "WiFi 已起,但不是 HE80/HE160(可能 client 不支持或 DFS 频段)"
else
    fail "WiFi 没工作"
fi

# ---- 12. Country code ----
cc_get=$(iw reg get 2>/dev/null | awk '/country/{print $2; exit}' | tr -d ':')
if [ "$cc_get" = "US" ]; then
    ok "Regulatory: country=$cc_get"
elif [ -n "$cc_get" ]; then
    warn "Regulatory: country=$cc_get (AX6 build default is US)"
else
    fail "Regulatory country code is unavailable"
fi

# ---- 13. NSS frame_mode 检查(关键的 NSS-redirect 入口)----
fm_path="/sys/module/ath11k/parameters/frame_mode"
if [ -r "$fm_path" ]; then
    fm=$(cat "$fm_path")
    case "$fm" in
        2) ok "ath11k frame_mode=2 (ethernet decapsulation, NSS WiFi offload)" ;;
        1) fail "ath11k frame_mode=1 (native WiFi); expected ethernet mode 2 for NSS offload" ;;
        0) fail "ath11k frame_mode=0 (raw); expected ethernet mode 2 for NSS offload" ;;
        *) warn "ath11k frame_mode=$fm 未知" ;;
    esac
else
    # 无线启用但参数文件缺失 → 可能是驱动未加载或异常
    if lsmod | grep -q ath11k; then
        fail "ath11k loaded but $fm_path missing — driver parameter node absent"
    fi
fi

# ---- 13b. NSS offload 参数检查 ----
no_path="/sys/module/ath11k/parameters/nss_offload"
if [ -r "$no_path" ]; then
    no_val=$(cat "$no_path")
    if [ "$no_val" = "1" ]; then
        ok "ath11k nss_offload=1 (NSS WiFi offload enabled)"
    else
        fail "ath11k nss_offload=$no_val; expected 1 for NSS offload"
    fi
else
    lsmod | grep -q ath11k && fail "ath11k loaded but nss_offload parameter absent"
fi

# ---- 13c. crypto_mode 参数检查 ----
cm_path="/sys/module/ath11k/parameters/crypto_mode"
if [ -r "$cm_path" ]; then
    cm_val=$(cat "$cm_path")
    if [ "$cm_val" = "0" ]; then
        ok "ath11k crypto_mode=0 (hardware crypto)"
    else
        fail "ath11k crypto_mode=$cm_val; expected 0 for hardware crypto path"
    fi
else
    lsmod | grep -q ath11k && fail "ath11k loaded but crypto_mode parameter absent"
fi

# ---- 14. VLAN 配置与 NSS WiFi offload ----
# qosmio 上游明确要求 NSS WiFi 使用 802.1q 子接口,不要使用 DSA bridge VLAN filtering。
vf_bad=0
for d in $(uci -q show network 2>/dev/null | awk -F'[.=]' '/=device$/{print $2}'); do
    if [ "$(uci -q get "network.${d}.vlan_filtering")" = "1" ]; then
        fail "network.$d.vlan_filtering=1 与 qosmio NSS WiFi offload 说明冲突;改用 802.1q 子接口"
        vf_bad=1
    fi
done

if uci -q show network 2>/dev/null | grep -q '=bridge-vlan'; then
    fail "/etc/config/network 存在 bridge-vlan 段; qosmio 上游说明它不兼容 NSS WiFi offload"
    vf_bad=1
else
    ok "无 bridge-vlan 段配置"
fi
[ "$vf_bad" -eq 0 ] && ok "未启用 bridge VLAN filtering (使用 802.1q 子接口拓扑)"

# 8021q / NSS VLAN 支持 (只要有一种 VLAN 机制就 pass)
if lsmod | grep -qE "^(8021q|qca_nss_vlan) "; then
    ok "VLAN 支持: $(lsmod | grep -oE '^(8021q|qca_nss_vlan)[^ ]*')"
else
    # 8021q 可能编入内核 (CONFIG_VLAN_8021Q=y), 无独立模块
    # 只要 /proc/net/vlan 存在就说明 VLAN 可用
    if [ -e /proc/net/vlan/config ]; then
        ok "VLAN 支持: 内核内置或通过 NSS"
    else
        warn "VLAN 状态未知 (无 8021q/qca_nss_vlan 模块,且 /proc/net/vlan 不存在)"
    fi
fi

# NSS VLAN 卸载 (qca_nss_vlan 提供硬件 VLAN tag 处理)
if lsmod | grep -q "^qca_nss_vlan "; then
    ok "NSS VLAN 卸载就绪 (qca_nss_vlan)"
fi

# ---- 15. ECM netdev offload policy ----
# IPQ807x 的本机终结流量需要关闭 Linux netdev checksum/GRO/GSO/TSO 类 offload;
# NSS/ECM 转发加速仍由 qca-nss-ecm 管理,不应关闭 ECM/NSS 本身。
ecm_disable_offloads=$(uci -q get ecm.general.disable_offloads)
ecm_disable_gro_list=$(uci -q get ecm.general.disable_gro_list)
ecm_disable_flow_control=$(uci -q get ecm.general.disable_flow_control)
if [ "$ecm_disable_offloads" = "1" ]; then
    ok "ECM disable_offloads=1"
else
    fail "ECM disable_offloads=${ecm_disable_offloads:-unset}; expected 1"
fi
if [ "$ecm_disable_gro_list" = "1" ]; then
    ok "ECM disable_gro_list=1"
else
    fail "ECM disable_gro_list=${ecm_disable_gro_list:-unset}; expected 1"
fi
case "$ecm_disable_flow_control" in
    "" | 0)
        ok "ECM disable_flow_control=${ecm_disable_flow_control:-unset} (no forced PAUSE/autoneg change)"
        ;;
    *)
        warn "ECM disable_flow_control=$ecm_disable_flow_control changes Ethernet PAUSE/autoneg; keep disabled unless a link-specific test proves it helps"
        ;;
esac

# qca-nss-ecm's official helper applies disable_offloads to physical netdevs.
# ax6-network-invariants repeats it after qca-nss-dp/netifd startup and applies
# the same policy to br-lan, so enabled features now indicate policy drift.
# severity arg: $2 = "fail" (default) or "warn"
check_offload_disabled() {
    _dev="$1"
    _sev="${2:-fail}"
    [ -d "/sys/class/net/$_dev" ] || return 0
    if ! ethtool -k "$_dev" >/tmp/nss-check-ethtool.$$ 2>/dev/null; then
        warn "Cannot inspect ethtool offloads on $_dev"
        return 0
    fi
    _bad=""
    for _feature in \
        rx-checksumming \
        tx-checksumming \
        scatter-gather \
        tcp-segmentation-offload \
        generic-segmentation-offload \
        generic-receive-offload \
        rx-gro-list; do
        if awk -v f="^${_feature}:" '$0 ~ f && $2 == "on" {found=1} END{exit !found}' \
            /tmp/nss-check-ethtool.$$; then
            _bad="${_bad}${_bad:+,}${_feature}"
        fi
    done
    rm -f /tmp/nss-check-ethtool.$$
    if [ -n "$_bad" ]; then
        if [ "$_sev" = "warn" ]; then
            warn "$_dev offloads on: $_bad (physical port; report-only, correlate with packet-integrity tests)"
        else
            fail "$_dev offloads still enabled: $_bad"
        fi
    else
        ok "$_dev checksum/GRO/GSO/TSO offloads disabled"
    fi
}

# br-lan and physical NSS data-path ports must match disable_offloads=1.
check_offload_disabled br-lan fail
for _offload_dev in wan lan1 lan2 lan3; do
    check_offload_disabled "$_offload_dev" fail
done

# ---- 16. ZRAM swap 实际启用 ----
if [ ! -r /proc/swaps ]; then
    fail "/proc/swaps 不存在 — 内核未启用 CONFIG_SWAP"
elif grep -q '/dev/zram' /proc/swaps; then
    zram_kb=$(awk '/\/dev\/zram/{total += $3} END{print total + 0}' /proc/swaps)
    ok "ZRAM swap active: ${zram_kb} kB"
    zram_expected_mb=$(uci -q get system.@system[0].zram_size_mb)
    [ -n "$zram_expected_mb" ] || zram_expected_mb=256
    case "$zram_expected_mb" in
        ''|*[!0-9]*|0)
            fail "Invalid system zram_size_mb='${zram_expected_mb}'"
            ;;
        *)
            zram_expected_kb=$((zram_expected_mb * 1024))
            if [ "$zram_kb" -ge $((zram_expected_kb - 1024)) ] &&
               [ "$zram_kb" -le $((zram_expected_kb + 1024)) ]; then
                ok "ZRAM size matches UCI policy: ${zram_expected_mb} MB"
            else
                warn "ZRAM size ${zram_kb} kB differs from UCI policy ${zram_expected_mb} MB"
            fi
            ;;
    esac
    zram_device=$(awk '/\/dev\/zram/{print $1; exit}' /proc/swaps)
    zram_device=${zram_device##*/}
    zram_algo=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' \
        "/sys/block/${zram_device}/comp_algorithm" 2>/dev/null)
    zram_expected_algo=$(uci -q get system.@system[0].zram_comp_algo)
    [ -n "$zram_expected_algo" ] || zram_expected_algo=zstd
    if [ "$zram_algo" = "$zram_expected_algo" ]; then
        ok "ZRAM compressor active: $zram_algo"
    else
        fail "ZRAM compressor is ${zram_algo:-unknown}; expected $zram_expected_algo"
    fi
else
    fail "ZRAM 设备未加入 /proc/swaps — 检查 /etc/init.d/zram"
fi

# ---- 17. WiFi 2.4G HE40/HE20 coexistence ----
coex_bad=0
for radio in $(uci -q show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-device$/{print $2}'); do
    [ "$(uci -q get "wireless.${radio}.band")" = "2g" ] || continue
    if [ "$(uci -q get "wireless.${radio}.htmode")" = "HE40" ] &&
       [ "$(uci -q get "wireless.${radio}.ht_coex")" != "1" ]; then
        fail "wireless.$radio uses HE40 without ht_coex=1"
        coex_bad=1
    fi
    if [ "$(uci -q get "wireless.${radio}.noscan")" = "1" ]; then
        fail "wireless.$radio.noscan=1 disables coexistence checks"
        coex_bad=1
    fi
done
[ "$coex_bad" -eq 0 ] && ok "2.4G HE40/HE20 coexistence configuration is safe"

# ---- 18. 上游 NSS/IRQ/RPS 启动链 ----
for svc in \
    S26qca-nss-ecm \
    S28qca-nss-drv \
    S29qca-nss-netlink \
    S93smp_affinity \
    S99set-irq-affinity; do
    if [ -e "/etc/rc.d/$svc" ]; then
        ok "Upstream NSS/IRQ/RPS service enabled: $svc"
    else
        fail "Missing upstream NSS/IRQ/RPS startup link: /etc/rc.d/$svc"
    fi
done
if [ -e "/etc/rc.d/S19qca-nss-pbuf" ]; then
    ok "Upstream NSS pbuf service enabled early: S19qca-nss-pbuf"
elif [ -e "/etc/rc.d/S27qca-nss-pbuf" ]; then
    warn "NSS pbuf service uses legacy order: S27qca-nss-pbuf; verify N2H profile below"
else
    fail "Missing upstream NSS pbuf startup link: /etc/rc.d/S19qca-nss-pbuf or S27qca-nss-pbuf"
fi

nss_rps_enable=$(sysctl -n dev.nss.rps.enable 2>/dev/null)
if [ "$nss_rps_enable" = "1" ]; then
    ok "NSS internal RPS enabled (dev.nss.rps.enable=1)"
else
    warn "NSS internal RPS enable=${nss_rps_enable:-unset}; qca-nss-drv may not have completed"
fi

nss_hash_bitmap=$(sysctl -n dev.nss.rps.hash_bitmap 2>/dev/null)
case "$nss_hash_bitmap" in
    ""|0)
        warn "NSS RPS hash_bitmap=${nss_hash_bitmap:-unset}; qca-nss-pbuf may not have completed"
        ;;
    *)
        ok "NSS RPS hash_bitmap=$nss_hash_bitmap"
        ;;
esac

# ---- 19. NSS pbuf/N2H profile actually applied ----
pbuf_profile=$(uci -q get pbuf.opt.memory_profile)
[ -n "$pbuf_profile" ] || pbuf_profile=auto
case "$pbuf_profile" in
    off*|false*|disable*|0)
        warn "NSS pbuf memory_profile=$pbuf_profile (disabled)"
        ;;
    *)
        memtotal=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null)
        case "$pbuf_profile" in
            auto)
                if [ -n "$memtotal" ] && [ "$memtotal" -gt 512000 ] 2>/dev/null; then
                    pbuf_expected_extra=10000000
                    pbuf_expected_high=65536
                    pbuf_expected_wifi=32768
                    pbuf_label=1GB
                elif [ -n "$memtotal" ] && [ "$memtotal" -le 256000 ] 2>/dev/null; then
                    pbuf_expected_extra=4000000
                    pbuf_expected_high=16384
                    pbuf_expected_wifi=8192
                    pbuf_label=256MB
                else
                    pbuf_expected_extra=8000000
                    pbuf_expected_high=32768
                    pbuf_expected_wifi=16384
                    pbuf_label=512MB
                fi
                ;;
            1024|1g*)
                pbuf_expected_extra=10000000
                pbuf_expected_high=65536
                pbuf_expected_wifi=32768
                pbuf_label=1GB
                ;;
            512|512m*)
                pbuf_expected_extra=8000000
                pbuf_expected_high=32768
                pbuf_expected_wifi=16384
                pbuf_label=512MB
                ;;
            256|256m*)
                pbuf_expected_extra=4000000
                pbuf_expected_high=16384
                pbuf_expected_wifi=8192
                pbuf_label=256MB
                ;;
            *)
                fail "NSS pbuf memory_profile=$pbuf_profile is invalid"
                pbuf_expected_extra=
                ;;
        esac

        if [ -n "${pbuf_expected_extra:-}" ]; then
            pbuf_extra=$(sysctl -n dev.nss.n2hcfg.extra_pbuf_core0 2>/dev/null)
            pbuf_high=$(sysctl -n dev.nss.n2hcfg.n2h_high_water_core0 2>/dev/null)
            pbuf_wifi=$(sysctl -n dev.nss.n2hcfg.n2h_wifi_pool_buf 2>/dev/null)
            if [ "${pbuf_extra:-0}" -ge "$pbuf_expected_extra" ] 2>/dev/null &&
               [ "${pbuf_high:-0}" -ge "$pbuf_expected_high" ] 2>/dev/null &&
               [ "${pbuf_wifi:-0}" -ge "$pbuf_expected_wifi" ] 2>/dev/null; then
                ok "NSS pbuf/N2H profile applied (${pbuf_label}: extra=${pbuf_extra}, high=${pbuf_high}, wifi_pool=${pbuf_wifi})"
            elif [ "${pbuf_extra:-0}" -ge "$pbuf_expected_extra" ] 2>/dev/null &&
                 [ "${pbuf_wifi:-0}" -ge "$pbuf_expected_wifi" ] 2>/dev/null &&
                 [ $(( ${pbuf_high:-0} + ${pbuf_wifi:-0} )) -ge "$pbuf_expected_high" ] 2>/dev/null; then
                warn "NSS pbuf/N2H firmware split budget (${pbuf_label}: extra=${pbuf_extra}, high=${pbuf_high}, wifi_pool=${pbuf_wifi}; total=$(( ${pbuf_high:-0} + ${pbuf_wifi:-0} )) >= ${pbuf_expected_high})"
            else
                fail "NSS pbuf/N2H profile not applied: extra=${pbuf_extra:-unset}/${pbuf_expected_extra}, high=${pbuf_high:-unset}/${pbuf_expected_high}, wifi_pool=${pbuf_wifi:-unset}/${pbuf_expected_wifi}"
            fi
        fi
        ;;
esac

edma_stats="/sys/kernel/debug/qca-nss-drv/stats/edma/err_stats"
if [ -r "$edma_stats" ]; then
    edma_alloc_1=$(awk '/edma_err_alloc_fail_cnt/{print $3}' "$edma_stats" 2>/dev/null)
    sleep 2
    edma_alloc_2=$(awk '/edma_err_alloc_fail_cnt/{print $3}' "$edma_stats" 2>/dev/null)
    edma_delta=$(( ${edma_alloc_2:-0} - ${edma_alloc_1:-0} ))
    if [ "$edma_delta" -gt 300 ] 2>/dev/null; then
        fail "NSS EDMA alloc failures growing quickly: +${edma_delta}/2s"
    elif [ "$edma_delta" -gt 50 ] 2>/dev/null; then
        warn "NSS EDMA alloc failures still growing: +${edma_delta}/2s"
    else
        ok "NSS EDMA alloc-fail growth is stable (+${edma_delta}/2s)"
    fi
fi

# ---- 20. IRQ 策略所有权 ----
if find /etc/rc.d -maxdepth 1 -name 'S*ax6-irq-affinity' 2>/dev/null | grep -q .; then
    fail "ax6-irq-affinity 被自动启用,会覆盖上游 qualcommax IRQ/RPS 策略"
else
    ok "IRQ/RPS 自动策略由上游 qualcommax 管理"
fi

# ---- 21. IPv4 interface invariants ----
ipv4_invariant_bad=""
for directory in /proc/sys/net/ipv4/conf/*; do
    [ -d "$directory" ] || continue
    interface="${directory##*/}"
    [ "$interface" != "lo" ] || continue

    for expected in \
        send_redirects:0 \
        accept_redirects:0 \
        arp_ignore:1; do
        setting="${expected%%:*}"
        value="${expected##*:}"
        actual=$(cat "$directory/$setting" 2>/dev/null)
        if [ "$actual" != "$value" ]; then
            ipv4_invariant_bad="${ipv4_invariant_bad} ${interface}.${setting}=${actual:-unset}"
        fi
    done
done
if [ -n "$ipv4_invariant_bad" ]; then
    fail "IPv4 interface invariant drift:${ipv4_invariant_bad}"
else
    ok "IPv4 interface redirect/ARP invariants applied"
fi
if [ -e /etc/rc.d/S95ax6-network-invariants ]; then
    ok "IPv4 interface invariant service enabled"
else
    fail "Missing startup link: /etc/rc.d/S95ax6-network-invariants"
fi

# ---- 22. Overlay 空间检查 ----
overlay_use=$(df /overlay 2>/dev/null | awk 'NR==2 {gsub(/%/,""); print $5}')
if [ -n "$overlay_use" ] 2>/dev/null; then
    if [ "$overlay_use" -ge 90 ] 2>/dev/null; then
        fail "overlay usage ${overlay_use}% — 空间不足可能导致配置保存或软件安装失败"
    elif [ "$overlay_use" -ge 80 ] 2>/dev/null; then
        warn "overlay usage ${overlay_use}% — 建议清理"
    else
        ok "overlay usage ${overlay_use}%"
    fi
fi

if [ "$QUIET" -eq 0 ]; then
    echo ""
    echo "=== 汇总: PASS=$PASS  WARN=$WARN  FAIL=$FAIL ==="
    if [ "$FAIL" -eq 0 ]; then
        echo "状态: ✓ 健康"
    else
        echo "状态: ✗ 有问题,看上面 FAIL 项"
    fi
    echo "场景配置审计: ax6-config-audit -v"
fi
exit "$FAIL"
