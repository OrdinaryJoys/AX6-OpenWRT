#!/bin/sh
# NSS-兼容 VLAN 配置助手
# 用法: vlan-add <vlan-id> <name> <ipaddr/cidr> [port1 port2 ...]
#
# 示例(添加 IoT VLAN 40,网关 192.168.40.1/24,在 lan1 lan2 上 tag):
#   vlan-add 40 iot 192.168.40.1/24 lan1 lan2
#
# 添加访客 VLAN 30,在所有 LAN 口:
#   vlan-add 30 guest 192.168.30.1/24 lan1 lan2 lan3 lan4
#
# 这个脚本会:
#   1. 创建 br-{name} bridge,添加 lan{N}.{vid} tagged 子接口
#   2. 创建 interface {name},static ip
#   3. 创建 firewall zone + DHCP
#   4. 提示用户按需添加 WiFi SSID
#
# 这是 qosmio NSS 推荐的 8021q 子接口方式,不是 bridge_vlan_filtering

usage() {
    cat <<EOF
Usage: $0 <vlan-id> <name> <ip/cidr> [port1 port2 ...]

NSS-compatible VLAN setup using 802.1q sub-interfaces.

Arguments:
  vlan-id   2-4094 (1 reserved for primary lan)
  name      lowercase, [a-z][a-z0-9_]*  e.g. 'guest', 'iot', 'office'
  ip/cidr   gateway address, e.g. 192.168.40.1/24
  port      lan1 / lan2 / lan3 / lan4 (default: all 4)

Example:
  $0 40 iot 192.168.40.1/24 lan1 lan2

Creates network, firewall and DHCP config. WiFi SSID remains manual because
SSID/password/encryption are site-specific.
EOF
    exit 1
}

if [ "$#" -lt 3 ]; then
    usage
fi

VID="$1"
NAME="$2"
IPADDR="$3"
shift 3
PORTS="${*:-lan1 lan2 lan3 lan4}"

# ---- 输入校验 -----------------------------------------------------------

# vlan-id: 必须是数字
case "$VID" in
    ''|*[!0-9]*)
        echo "error: vlan-id must be numeric" >&2
        exit 2
        ;;
esac

# vlan-id: 范围 2..4094
if [ "$VID" -lt 2 ] || [ "$VID" -gt 4094 ]; then
    echo "error: vlan-id must be 2-4094 (1 is primary lan)" >&2
    exit 2
fi

# name: 仅允许 [a-z][a-z0-9_]* (UCI section 名规则)
if ! echo "$NAME" | grep -Eq '^[a-z][a-z0-9_]*$'; then
    echo "error: name must match [a-z][a-z0-9_]* (UCI section names allow only alphanumeric and underscore)" >&2
    exit 2
fi

# ip/cidr: 形如 192.168.x.y/N
if ! echo "$IPADDR" | grep -Eq '^[0-9.]+/[0-9]+$'; then
    echo "error: ip must be CIDR e.g. 192.168.40.1/24" >&2
    exit 2
fi
IP="${IPADDR%/*}"
MASK_BITS="${IPADDR#*/}"
if ! awk -v ip="$IP" -v bits="$MASK_BITS" 'BEGIN {
    n = split(ip, octets, ".")
    if (n != 4) exit 1
    for (i = 1; i <= 4; i++) {
        if (octets[i] !~ /^[0-9]+$/ || octets[i] < 0 || octets[i] > 255) exit 1
    }
    if (bits !~ /^[0-9]+$/ || bits < 1 || bits > 32) exit 1
}'; then
    echo "error: ip must be a valid IPv4 CIDR e.g. 192.168.40.1/24" >&2
    exit 2
fi

# ---- 拓扑提示 -----------------------------------------------------------
VLAN_FILTERING_BAD=0
for d in $(uci -q show network 2>/dev/null | awk -F'[.=]' '/=device$/{print $2}'); do
    if [ "$(uci -q get "network.${d}.vlan_filtering")" = "1" ]; then
        echo "error: network.$d.vlan_filtering=1 conflicts with qosmio NSS WiFi offload guidance." >&2
        echo "       Disable DSA bridge VLAN filtering before creating 802.1q subinterfaces." >&2
        VLAN_FILTERING_BAD=1
    fi
done
if uci -q show network 2>/dev/null | grep -q '=bridge-vlan'; then
    echo "error: /etc/config/network contains bridge-vlan sections." >&2
    echo "       Migrate DSA bridge VLAN filtering to 802.1q subinterfaces first." >&2
    VLAN_FILTERING_BAD=1
fi
[ "$VLAN_FILTERING_BAD" -eq 0 ] || exit 6

# ---- 名字未占用检查 -----------------------------------------------------
if uci -q get "network.$NAME" >/dev/null 2>&1; then
    echo "error: interface 'network.$NAME' already exists" >&2
    exit 4
fi
if uci -q get "network.br_$NAME" >/dev/null 2>&1; then
    echo "error: device 'network.br_$NAME' already exists" >&2
    exit 4
fi
if uci -q get "firewall.$NAME" >/dev/null 2>&1; then
    echo "error: firewall zone 'firewall.$NAME' already exists" >&2
    exit 4
fi
for z in $(uci -q show firewall 2>/dev/null | awk -F'[.=]' '/=zone$/{print $2}'); do
    if [ "$(uci -q get "firewall.${z}.name")" = "$NAME" ]; then
        echo "error: firewall zone named '$NAME' already exists in section firewall.$z" >&2
        exit 4
    fi
done
if uci -q get "firewall.${NAME}_wan" >/dev/null 2>&1; then
    echo "error: firewall forwarding 'firewall.${NAME}_wan' already exists" >&2
    exit 4
fi
if uci -q get "dhcp.$NAME" >/dev/null 2>&1; then
    echo "error: DHCP section 'dhcp.$NAME' already exists" >&2
    exit 4
fi

# ---- 构造 ports 列表 ----------------------------------------------------
PORT_LIST=""
# shellcheck disable=SC2086 # PORTS 故意不引号:用空格切分多个端口名
for p in $PORTS; do
    case "$p" in
        lan1|lan2|lan3|lan4)
            PORT_LIST="$PORT_LIST $p.$VID"
            ;;
        *)
            echo "error: invalid port '$p' (use lan1/lan2/lan3/lan4)" >&2
            exit 5
            ;;
    esac
done

echo "Adding VLAN $VID '$NAME' on:$PORT_LIST"
echo "  br-$NAME → $IPADDR"

# ---- (1) bridge device --------------------------------------------------
uci -q batch <<EOF
set network.br_$NAME=device
set network.br_$NAME.type=bridge
set network.br_$NAME.name=br-$NAME
set network.br_$NAME.bridge_empty=1
EOF
# shellcheck disable=SC2086 # PORT_LIST 故意不引号:用空格切分多个端口名
for p in $PORT_LIST; do
    uci -q add_list "network.br_$NAME.ports=$p"
done

# ---- (2) interface ------------------------------------------------------
# CIDR 位数 → 点分十进制(用 awk -v 安全传参,避免 shell 注入)
NETMASK="$(awk -v bits="$MASK_BITS" 'BEGIN {
    m = 4294967295 - 2^(32 - bits) + 1
    for (i = 3; i >= 0; i--) {
        printf "%d%s", int(m / 2^(8 * i)) % 256, (i ? "." : "")
    }
}')"

uci -q batch <<EOF
set network.$NAME=interface
set network.$NAME.proto=static
set network.$NAME.device=br-$NAME
set network.$NAME.ipaddr=$IP
set network.$NAME.netmask=$NETMASK
EOF

uci commit network

# ---- (3) firewall zone + WAN forwarding --------------------------------
uci -q batch <<EOF
set firewall.$NAME=zone
set firewall.$NAME.name=$NAME
set firewall.$NAME.input=ACCEPT
set firewall.$NAME.output=ACCEPT
set firewall.$NAME.forward=REJECT
add_list firewall.$NAME.network=$NAME
set firewall.${NAME}_wan=forwarding
set firewall.${NAME}_wan.src=$NAME
set firewall.${NAME}_wan.dest=wan
EOF
uci commit firewall

# ---- (4) DHCP -----------------------------------------------------------
uci -q batch <<EOF
set dhcp.$NAME=dhcp
set dhcp.$NAME.interface=$NAME
set dhcp.$NAME.start=100
set dhcp.$NAME.limit=150
set dhcp.$NAME.leasetime=12h
EOF
uci commit dhcp

cat <<EOF

✓ VLAN $VID '$NAME' added.

Created:
  - network.br_$NAME bridge with:$PORT_LIST
  - network.$NAME static gateway $IPADDR
  - firewall.$NAME zone with forwarding to wan
  - dhcp.$NAME pool 100-249

Optional WiFi SSID:
  Add a wifi-iface with option network '$NAME' and your own SSID/key.

Apply:
  /etc/init.d/network reload
  /etc/init.d/firewall restart
  /etc/init.d/dnsmasq restart

Verify:
  ax6-config-audit -v
  nss-check -v
  After some traffic:
       cat /sys/kernel/debug/qca-nss-drv/vlan/info  2>/dev/null

EOF
