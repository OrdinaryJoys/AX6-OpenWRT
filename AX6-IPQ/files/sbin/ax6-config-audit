#!/bin/sh
# Read-only audit for scenario-dependent WiFi, NSS SQM, ZeroTier, UPnP,
# OpenVPN, VLMCS and OpenClash config.
# Usage: ax6-config-audit [-v|-q]

VERBOSE=0
QUIET=0
ZT_FW_PATH="${ZT_FW_PATH:-/var/run/zerotier-one/_fw4}"

case "${1:-}" in
    ""|"--") ;;
    -v|--verbose) VERBOSE=1 ;;
    -q|--quiet) QUIET=1 ;;
    -h|--help)
        sed -n '2,3p' "$0" | sed 's/^# //'
        exit 0
        ;;
    *)
        echo "ax6-config-audit: unknown option '$1' (use -v / -q / -h)" >&2
        exit 64
        ;;
esac

PASS=0
WARN=0
FAIL=0

ok() {
    PASS=$((PASS + 1))
    [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ] && echo " ✓ $1"
}

warn() {
    WARN=$((WARN + 1))
    [ "$QUIET" -eq 0 ] && echo " ! $1"
}

fail() {
    FAIL=$((FAIL + 1))
    [ "$QUIET" -eq 0 ] && echo " ✗ $1"
}

is_private_v4() {
    case "$1" in
        10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
        *) return 1 ;;
    esac
}

zerotier_include_ok() {
    _zt_section="$1"
    _zt_expected_path="$2"
    _zt_expected_chain="$3"
    [ "$(uci -q get "firewall.${_zt_section}.type")" = "nftables" ] &&
        [ "$(uci -q get "firewall.${_zt_section}.path")" = "$_zt_expected_path" ] &&
        [ "$(uci -q get "firewall.${_zt_section}.position")" = "chain-pre" ] &&
        [ "$(uci -q get "firewall.${_zt_section}.chain")" = "$_zt_expected_chain" ] &&
        [ -r "$_zt_expected_path" ]
}

zerotier_config_present() {
    uci -q show zerotier 2>/dev/null |
        grep -Eq '^zerotier\.[^=]+=(network|zerotier)$'
}

zerotier_enabled() {
    if uci -q get zerotier.global >/dev/null 2>&1; then
        [ "$(uci -q get zerotier.global.enabled 2>/dev/null)" = "1" ]
        return
    fi

    for _zt_section in $(uci -q show zerotier 2>/dev/null |
        awk -F'[.=]' '/=zerotier$/ { print $2 }'); do
        [ "$(uci -q get "zerotier.${_zt_section}.enabled" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

zerotier_service_input_enabled() {
    if uci -q get zerotier.global >/dev/null 2>&1; then
        [ "$(uci -q get zerotier.global.fw_allow_input 2>/dev/null)" = "1" ]
        return
    fi

    for _zt_section in $(uci -q show zerotier 2>/dev/null |
        awk -F'[.=]' '/=zerotier$/ { print $2 }'); do
        [ "$(uci -q get "zerotier.${_zt_section}.enabled" 2>/dev/null)" = "1" ] || continue
        [ "$(uci -q get "zerotier.${_zt_section}.fw_allow_input" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

zerotier_network_sections() {
    uci -q show zerotier 2>/dev/null |
        awk -F'[.=]' '/=network$/ { print $2 }'
    for _zt_section in $(uci -q show zerotier 2>/dev/null |
        awk -F'[.=]' '/=zerotier$/ { print $2 }'); do
        [ "$_zt_section" = global ] && continue
        _zt_id="$(uci -q get "zerotier.${_zt_section}.id" 2>/dev/null || true)"
        _zt_join="$(uci -q get "zerotier.${_zt_section}.join" 2>/dev/null || true)"
        [ -n "$_zt_id$_zt_join" ] && printf '%s\n' "$_zt_section"
    done
}

openvpn_sections() {
    uci -q show openvpn 2>/dev/null |
        awk -F'[.=]' '/=openvpn$/ { print $2 }'
}

openvpn_any_server_enabled() {
    for _ovpn_section in $(openvpn_sections); do
        [ "$(uci -q get "openvpn.${_ovpn_section}.enabled")" = "1" ] && return 0
    done
    return 1
}

openvpn_active_wan_1194_rules() {
    for _ovpn_rule in $(uci -q show firewall 2>/dev/null |
        awk -F'[.=]' '/=rule$/ { print $2 }'); do
        [ "$(uci -q get "firewall.${_ovpn_rule}.src")" = "wan" ] || continue
        [ "$(uci -q get "firewall.${_ovpn_rule}.dest_port")" = "1194" ] || continue
        [ "$(uci -q get "firewall.${_ovpn_rule}.target")" = "ACCEPT" ] || continue
        [ "$(uci -q get "firewall.${_ovpn_rule}.enabled")" = "0" ] && continue
        printf '%s\n' "$_ovpn_rule"
    done
}

zerotier_port() {
    _zt_port_name="$1"
    zerotier-cli -j info 2>/dev/null |
        jsonfilter -qe "@.config.settings.${_zt_port_name}" 2>/dev/null
}

zerotier_valid_port() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

zerotier_owned_input_rules() {
    printf '%s\n' "$1" |
        grep -E 'Accept ZeroTier input [0-9]+ \((primaryPort|secondaryPort|tertiaryPort)\)' || true
}

zerotier_owned_rules() {
    printf '%s\n' "$1" |
        grep -E 'comment "!fw4: (Accept ZeroTier (input|output forward)|Masquerade ZeroTier traffic) ' || true
}

zerotier_input_rule_set_match() {
    _zt_rules="$1"
    _zt_owned="$(zerotier_owned_input_rules "$_zt_rules")"
    _zt_primary="$(zerotier_port primaryPort)"
    _zt_secondary="$(zerotier_port secondaryPort)"
    zerotier_valid_port "$_zt_primary" &&
        zerotier_valid_port "$_zt_secondary" || return 1
    _zt_expected_count=2
    _zt_tertiary=0
    case "$(zerotier_port portMappingEnabled)" in
        true|1)
            _zt_tertiary="$(zerotier_port tertiaryPort)"
            zerotier_valid_port "$_zt_tertiary" || return 1
            _zt_expected_count=3
            ;;
    esac
    [ "$(printf '%s\n' "$_zt_owned" | grep -c .)" -eq "$_zt_expected_count" ] || return 1

    _zt_rule="$(printf '%s\n' "$_zt_owned" |
        grep -F "input $_zt_primary (primaryPort)" | head -n 1)"
    printf '%s\n' "$_zt_rule" | grep -Eq "(meta l4proto \\{ udp \\} th|udp) dport $_zt_primary" || return 1
    printf '%s\n' "$_zt_rule" | grep -q tcp && return 1

    _zt_rule="$(printf '%s\n' "$_zt_owned" |
        grep -F "input $_zt_secondary (secondaryPort)" | head -n 1)"
    printf '%s\n' "$_zt_rule" | grep -Eq "(meta l4proto \{ udp \} th|udp) dport $_zt_secondary" || return 1
    printf '%s\n' "$_zt_rule" | grep -q tcp && return 1

    if [ "$_zt_tertiary" -gt 0 ]; then
        _zt_rule="$(printf '%s\n' "$_zt_owned" |
            grep -F "input $_zt_tertiary (tertiaryPort)" | head -n 1)"
        printf '%s\n' "$_zt_rule" | grep -Eq "(meta l4proto \{ udp \} th|udp) dport $_zt_tertiary" || return 1
        printf '%s\n' "$_zt_rule" | grep -q tcp && return 1
    fi
    return 0
}

zerotier_input_ports_match() {
    _zt_include="$(cat "$ZT_FW_PATH/input.nft" 2>/dev/null)" || {
        fail "ZeroTier: nft input include cannot be read"
        return
    }
    if zerotier_input_rule_set_match "$_zt_include"; then
        ok "ZeroTier: nft input include exactly matches daemon ports and protocols"
    else
        fail "ZeroTier: nft input include has missing, stale, or protocol-mismatched service ports"
    fi

    _zt_live="$(nft -a list chain inet fw4 input 2>/dev/null)" || {
        fail "ZeroTier: live fw4 input chain cannot be read"
        return
    }
    if zerotier_input_rule_set_match "$_zt_live"; then
        ok "ZeroTier: live nft input rules exactly match daemon ports and protocols"
    else
        fail "ZeroTier: live nft input rules differ from daemon ports or include stale rules"
    fi
}

zerotier_owned_input_absent() {
    _zt_include="$(cat "$ZT_FW_PATH/input.nft" 2>/dev/null || true)"
    _zt_live="$(nft -a list chain inet fw4 input 2>/dev/null || true)"
    [ -z "$(zerotier_owned_input_rules "$_zt_include")" ] &&
        [ -z "$(zerotier_owned_input_rules "$_zt_live")" ]
}

zerotier_owned_firewall_absent() {
    for _zt_path in \
        "$ZT_FW_PATH/input.nft" \
        "$ZT_FW_PATH/forward.nft" \
        "$ZT_FW_PATH/srcnat.nft"; do
        [ ! -r "$_zt_path" ] ||
            [ -z "$(zerotier_owned_rules "$(cat "$_zt_path" 2>/dev/null)")" ] || return 1
    done

    for _zt_chain in input forward srcnat; do
        _zt_live="$(nft -a list chain inet fw4 "$_zt_chain" 2>/dev/null)" || return 1
        [ -z "$(zerotier_owned_rules "$_zt_live")" ] || return 1
    done
}

openclash_zerotier_bypass_match() {
    _oczt_primary="$(zerotier_port primaryPort)"
    _oczt_secondary="$(zerotier_port secondaryPort)"
    zerotier_valid_port "$_oczt_primary" &&
        zerotier_valid_port "$_oczt_secondary" || return 1
    _oczt_udp_ports="$_oczt_secondary"
    case "$(zerotier_port portMappingEnabled)" in
        true|1)
            _oczt_tertiary="$(zerotier_port tertiaryPort)"
            zerotier_valid_port "$_oczt_tertiary" || return 1
            _oczt_udp_ports="$_oczt_udp_ports $_oczt_tertiary"
            ;;
    esac

    _oczt_checked=0
    for _oczt_chain in \
        openclash_output \
        openclash_mangle_output \
        openclash_output_v6 \
        openclash_mangle_output_v6; do
        _oczt_rules="$(nft -a list chain inet fw4 "$_oczt_chain" 2>/dev/null)" || continue
        _oczt_owned="$(printf '%s\n' "$_oczt_rules" |
            grep -F -e 'AX6 ZeroTier primary self bypass' \
                -e 'AX6 ZeroTier UDP self bypass' \
                -e 'AX6 ZeroTier self bypass' || true)"
        [ "$(printf '%s\n' "$_oczt_owned" | grep -c .)" -eq 2 ] || return 1
        printf '%s\n' "$_oczt_owned" | grep -Fq 'AX6 ZeroTier self bypass' && return 1

        _oczt_rule="$(printf '%s\n' "$_oczt_owned" |
            grep -F 'AX6 ZeroTier primary self bypass' | head -n 1)"
        printf '%s\n' "$_oczt_rule" | grep -q "sport $_oczt_primary" || return 1
        printf '%s\n' "$_oczt_rule" | grep -q tcp || return 1
        printf '%s\n' "$_oczt_rule" | grep -q udp || return 1

        _oczt_rule="$(printf '%s\n' "$_oczt_owned" |
            grep -F 'AX6 ZeroTier UDP self bypass' | head -n 1)"
        printf '%s\n' "$_oczt_rule" | grep -q 'udp sport' || return 1
        printf '%s\n' "$_oczt_rule" | grep -q tcp && return 1
        _oczt_checked=$((_oczt_checked + 1))
        for _oczt_port in $_oczt_udp_ports; do
            printf '%s\n' "$_oczt_rule" |
                grep -Eq "(^|[^0-9])${_oczt_port}([^0-9]|$)" || return 1
        done
        _oczt_actual_ports="$(printf '%s\n' "$_oczt_rule" |
            awk '
                {
                    for (i = 1; i <= NF; i++) {
                        if ($i != "sport") continue
                        i++
                        if ($i == "{") i++
                        for (; i <= NF && $i != "}"; i++) {
                            gsub(/,/, "", $i)
                            if ($i ~ /^[0-9]+$/) print $i
                        }
                        exit
                    }
                }
            ' | sort -n)"
        _oczt_expected_ports="$(printf '%s\n' "$_oczt_udp_ports" | tr ' ' '\n' | sed '/^$/d' | sort -n)"
        [ "$_oczt_actual_ports" = "$_oczt_expected_ports" ] || return 1
    done
    [ "$_oczt_checked" -gt 0 ]
}

openclash_zerotier_bypass_absent() {
    for _oczt_chain in \
        openclash_output \
        openclash_mangle_output \
        openclash_output_v6 \
        openclash_mangle_output_v6; do
        nft -a list chain inet fw4 "$_oczt_chain" 2>/dev/null |
            grep -F -e 'AX6 ZeroTier primary self bypass' \
                -e 'AX6 ZeroTier UDP self bypass' \
                -e 'AX6 ZeroTier self bypass' >/dev/null && return 1
    done
    return 0
}

openclash_dns_servers() {
    uci -q show openclash 2>/dev/null |
        awk -F'[.=]' '/=dns_servers$/ { print $2 }'
}

openclash_dns_group_count() {
    _oc_group="$1"
    _oc_count=0
    for _oc_section in $(openclash_dns_servers); do
        [ "$(uci -q get "openclash.${_oc_section}.enabled")" = "0" ] && continue
        [ "$(uci -q get "openclash.${_oc_section}.group")" = "$_oc_group" ] || continue
        _oc_count=$((_oc_count + 1))
    done
    echo "$_oc_count"
}

openclash_default_dns_ipv6_conflict() {
    _oc_bad=0
    _oc_warn=0
    for _oc_section in $(openclash_dns_servers); do
        [ "$(uci -q get "openclash.${_oc_section}.enabled")" = "0" ] && continue
        [ "$(uci -q get "openclash.${_oc_section}.group")" = "default" ] || continue
        _oc_ip=$(uci -q get "openclash.${_oc_section}.ip")
        _oc_disable_ipv6=$(uci -q get "openclash.${_oc_section}.disable_ipv6")
        case "$_oc_ip" in
            *:*)
                fail "OpenClash: default DNS $_oc_ip conflicts with ipv6_dns=0"
                _oc_bad=1
                ;;
        esac
        if [ "$_oc_disable_ipv6" != "1" ]; then
            warn "OpenClash: default DNS ${_oc_ip:-unknown} should set disable_ipv6=1 when IPv6 DNS is disabled"
            _oc_warn=1
        fi
    done
    [ "$_oc_bad$_oc_warn" = "00" ] && ok "OpenClash: default DNS is IPv4-only with disable_ipv6=1"
}

openclash_path_kb() {
    [ -e "$1" ] || {
        echo 0
        return 0
    }
    du -sk "$1" 2>/dev/null | awk 'NR == 1 { print $1 + 0 }'
}

openclash_geodata_kb() {
    _oc_total=0
    for _oc_path in \
        /etc/openclash/GeoIP.dat \
        /etc/openclash/GeoSite.dat \
        /etc/openclash/ASN.mmdb \
        /etc/openclash/Country.mmdb \
        /etc/openclash/china_ip_route.ipset \
        /etc/openclash/china_ip6_route.ipset; do
        _oc_size=$(openclash_path_kb "$_oc_path")
        _oc_total=$((_oc_total + _oc_size))
    done
    echo "$_oc_total"
}

openclash_overlay_free_kb() {
    df -k /overlay 2>/dev/null | awk 'NR == 2 { print $4 + 0 }'
}

openclash_overlay_total_kb() {
    df -k /overlay 2>/dev/null | awk 'NR == 2 { print $2 + 0 }'
}

openclash_auto_geodata_enabled() {
    for _oc_option in \
        geoip_auto_update \
        geosite_auto_update \
        geoasn_auto_update \
        chnr_auto_update; do
        [ "$(uci -q get "openclash.config.${_oc_option}")" = "1" ] && echo "$_oc_option"
    done
}

if [ "$QUIET" -eq 0 ]; then
    echo "=== AX6 scenario configuration audit (read-only) ==="
fi

# WiFi: only coexistence settings are universal. BSS policy is reported, not fixed.
wifi_seen=0
for radio in $(uci -q show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-device$/{print $2}'); do
    wifi_seen=1
    band=$(uci -q get "wireless.${radio}.band")
    htmode=$(uci -q get "wireless.${radio}.htmode")
    if [ "$band" = "2g" ] && [ "$htmode" = "HE40" ]; then
        if [ "$(uci -q get "wireless.${radio}.ht_coex")" = "1" ] &&
           [ "$(uci -q get "wireless.${radio}.noscan")" != "1" ]; then
            ok "WiFi $radio: HE40 with 20/40 coexistence enabled"
        else
            fail "WiFi $radio: HE40 requires ht_coex=1 and noscan unset"
        fi
    fi
    if [ "$band" = "2g" ] && [ "$(uci -q get "wireless.${radio}.legacy_rates")" = "0" ]; then
        warn "WiFi $radio: legacy rates disabled; some 2.4G IoT devices may not associate"
    fi
done
[ "$wifi_seen" -eq 1 ] || fail "WiFi: no radio configuration found"

for iface in $(uci -q show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-iface$/{print $2}'); do
    ssid=$(uci -q get "wireless.${iface}.ssid")
    [ -n "$ssid" ] || ssid="$iface"
    [ "$(uci -q get "wireless.${iface}.isolate")" = "1" ] &&
        warn "WiFi $ssid: client isolation enabled; correct for guest/untrusted SSIDs, incompatible with peer discovery"
    [ "$(uci -q get "wireless.${iface}.proxy_arp")" = "1" ] &&
        warn "WiFi $ssid: proxy_arp enabled; verify IoT and peer-discovery requirements"
    [ "$(uci -q get "wireless.${iface}.multicast_to_unicast")" = "1" ] &&
        warn "WiFi $ssid: multicast_to_unicast enabled; verify mDNS discovery"
    [ "$(uci -q get "wireless.${iface}.uapsd")" = "0" ] &&
        warn "WiFi $ssid: U-APSD explicitly disabled; this may increase client power usage"
    [ "$(uci -q get "wireless.${iface}.wmm")" = "0" ] &&
        fail "WiFi $ssid: WMM disabled; 802.11n/ac/ax operation requires WMM"
    [ "$(uci -q get "wireless.${iface}.hidden")" = "1" ] &&
        warn "WiFi $ssid: hidden SSID may break IoT provisioning"
    [ "$(uci -q get "wireless.${iface}.ieee80211w")" = "2" ] &&
        warn "WiFi $ssid: PMF required; older IoT clients may not associate"
    encryption=$(uci -q get "wireless.${iface}.encryption")
    case "$encryption" in
        sae|sae-*)
            warn "WiFi $ssid: WPA3-only encryption may reject older IoT clients"
            ;;
    esac
done

# ECM: the AX6 profile must retain its host/physical policy after sysupgrade.
ecm_policy_bad=0
for ecm_setting in disable_offloads:1 disable_gro_list:1 offload_physical_policy:report; do
    ecm_key="${ecm_setting%%:*}"
    ecm_expected="${ecm_setting##*:}"
    ecm_actual="$(uci -q get "ecm.general.${ecm_key}")"
    if [ "$ecm_actual" = "$ecm_expected" ]; then
        ok "ECM: ${ecm_key}=${ecm_expected}"
    else
        fail "ECM: ${ecm_key}=${ecm_actual:-unset}; expected ${ecm_expected}"
        ecm_policy_bad=1
    fi
done
ecm_host_ifaces="$(uci -q get ecm.general.offload_host_ifaces)"
case " $ecm_host_ifaces " in
    *" br-lan "*) ok "ECM: br-lan is covered by the host-path policy" ;;
    *)
        fail "ECM: offload_host_ifaces=${ecm_host_ifaces:-unset}; expected br-lan"
        ecm_policy_bad=1
        ;;
esac
[ "$ecm_policy_bad" -eq 0 ] && ok "ECM: AX6 layered offload policy is complete"

# VLAN: qosmio upstream requires 802.1q subinterfaces for NSS WiFi offload.
vlan_bad=0
for device in $(uci -q show network 2>/dev/null | awk -F'[.=]' '/=device$/{print $2}'); do
    if [ "$(uci -q get "network.${device}.vlan_filtering")" = "1" ]; then
        fail "VLAN $device: vlan_filtering=1 conflicts with qosmio NSS WiFi offload guidance"
        vlan_bad=1
    fi
done
if uci -q show network 2>/dev/null | grep -q '=bridge-vlan'; then
    fail "VLAN: config bridge-vlan is present; use 802.1q subinterfaces such as lan1.40 instead"
    vlan_bad=1
fi
[ "$vlan_bad" -eq 0 ] && ok "VLAN: no DSA bridge VLAN filtering detected"

# NSS SQM: installed CAKE dependencies are harmless until a non-NSS queue is enabled.
if [ -r /etc/config/sqm ]; then
    sqm_seen=0
    for section in $(uci -q show sqm 2>/dev/null | awk -F'[.=]' '/=queue$/{print $2}'); do
        [ "$(uci -q get "sqm.${section}.enabled")" = "1" ] || continue
        sqm_seen=1
        script=$(uci -q get "sqm.${section}.script")
        if [ "$script" = "nss-zk.qos" ]; then
            ok "NSS SQM $section: nss-zk.qos selected"
        else
            warn "NSS SQM $section: enabled script '${script:-unset}' uses the CPU path; select nss-zk.qos for NSS shaping"
        fi
    done
    [ "$sqm_seen" -eq 1 ] || ok "NSS SQM: installed and disabled"
fi

# ZeroTier: routing and trust policy is scenario-dependent.
if zerotier_config_present; then
    if zerotier_enabled; then
        if pidof zerotier-one >/dev/null 2>&1; then
            ok "ZeroTier: daemon running"
        else
            fail "ZeroTier: enabled but daemon is not running"
        fi
        if find /sys/class/net -maxdepth 1 -name 'zt*' 2>/dev/null | grep -q .; then
            ok "ZeroTier: runtime interface present"
        else
            warn "ZeroTier: enabled but no zt* interface is present"
        fi
        zt_need_service_input=0
        zerotier_service_input_enabled && zt_need_service_input=1
        zt_need_input=$zt_need_service_input
        zt_need_forward=0
        zt_need_srcnat=0
        for section in $(zerotier_network_sections); do
            [ "$(uci -q get "zerotier.${section}.enabled")" = "0" ] && continue
            zt_network_ids="$(uci -q get "zerotier.${section}.id" 2>/dev/null ||
                uci -q get "zerotier.${section}.join" 2>/dev/null || true)"
            [ -n "$zt_network_ids" ] ||
                fail "ZeroTier $section: enabled network has no network id"
            [ "$(uci -q get "zerotier.${section}.allow_default")" = "1" ] &&
                warn "ZeroTier $section: remote network may install a default route"
            [ "$(uci -q get "zerotier.${section}.allow_global")" = "1" ] &&
                warn "ZeroTier $section: remote network may install global routes"
            [ "$(uci -q get "zerotier.${section}.allow_dns")" = "1" ] &&
                warn "ZeroTier $section: remote network may replace DNS"
            [ "$(uci -q get "zerotier.${section}.fw_allow_input")" = "1" ] &&
                zt_need_input=1
            [ "$(uci -q get "zerotier.${section}.fw_allow_forward")" = "1" ] &&
                zt_need_forward=1
            [ "$(uci -q get "zerotier.${section}.fw_allow_masq")" = "1" ] &&
                zt_need_srcnat=1
        done
        for section in $(uci -q show network 2>/dev/null | awk -F'[.=]' '/=interface$/{print $2}'); do
            device=$(uci -q get "network.${section}.device")
            case "$device" in
                zt*)
                    [ "$(uci -q get "network.${section}.proto")" = "dhcp" ] &&
                        fail "ZeroTier interface $section uses DHCP; ZeroTier must manage its own addresses"
                    ;;
            esac
        done
        zt_input_include_ok=0
        if zerotier_include_ok zerotier_input "$ZT_FW_PATH/input.nft" input; then
            ok "ZeroTier: dynamic nftables input include registered and readable"
            zt_input_include_ok=1
        else
            fail "ZeroTier: dynamic nftables input include is missing, unreadable, or malformed"
        fi
        if zerotier_include_ok zerotier_forward "$ZT_FW_PATH/forward.nft" forward; then
            ok "ZeroTier: dynamic nftables forward include registered and readable"
        else
            fail "ZeroTier: dynamic nftables forward include is missing, unreadable, or malformed"
        fi
        if zerotier_include_ok zerotier_srcnat "$ZT_FW_PATH/srcnat.nft" srcnat; then
            ok "ZeroTier: dynamic nftables srcnat include registered and readable"
        else
            fail "ZeroTier: dynamic nftables srcnat include is missing, unreadable, or malformed"
        fi
        if [ "$zt_need_service_input" = "1" ]; then
            [ "$zt_input_include_ok" = "1" ] && zerotier_input_ports_match
        elif zerotier_owned_input_absent; then
            ok "ZeroTier: service-port input permission disabled and no service-port rules remain"
        else
            fail "ZeroTier: service-port input permission disabled but stale service-port rules remain"
        fi
        [ "$zt_need_input$zt_need_forward$zt_need_srcnat" = "000" ] &&
            ok "ZeroTier: no package-managed firewall permissions requested"
    else
        if zerotier_owned_firewall_absent && openclash_zerotier_bypass_absent; then
            ok "ZeroTier: installed, disabled, and owned firewall rules are absent"
        else
            fail "ZeroTier: disabled but owned firewall or OpenClash bypass rules remain"
        fi
    fi
else
    ok "ZeroTier: not installed"
fi

# UPnP: enabled operation requires secure mode and a final deny rule.
if uci -q get upnpd.config >/dev/null 2>&1; then
    if [ "$(uci -q get upnpd.config.enabled)" = "1" ]; then
        if [ "$(uci -q get upnpd.config.secure_mode)" = "1" ]; then
            ok "UPnP: secure_mode enabled"
        else
            fail "UPnP: enabled without secure_mode=1"
        fi
        last_perm_rule=
        for section in $(uci -q show upnpd 2>/dev/null | awk -F'[.=]' '/=perm_rule$/{print $2}'); do
            last_perm_rule="$section"
        done
        if [ -n "$last_perm_rule" ] &&
           [ "$(uci -q get "upnpd.${last_perm_rule}.action")" = "deny" ] &&
           [ "$(uci -q get "upnpd.${last_perm_rule}.ext_ports")" = "0-65535" ] &&
           [ "$(uci -q get "upnpd.${last_perm_rule}.int_addr")" = "0.0.0.0/0" ] &&
           [ "$(uci -q get "upnpd.${last_perm_rule}.int_ports")" = "0-65535" ]; then
            ok "UPnP: final permission rule is complete default deny"
        else
            fail "UPnP: final permission rule is not a complete default deny"
        fi
        case " $(uci -q get upnpd.config.internal_iface) " in
            *" wan "*)
                fail "UPnP: WAN must not be configured as an internal interface"
                ;;
        esac
        wan_ip=$(ubus call network.interface.wan status 2>/dev/null |
            jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        is_private_v4 "$wan_ip" &&
            warn "UPnP: WAN address ${wan_ip:-unknown} is private; upstream NAT may prevent mappings"
    else
        ok "UPnP: disabled"
    fi
else
    ok "UPnP: not installed"
fi

# OpenVPN: the package default server is disabled, so WAN exposure must follow
# the actual service state rather than merely the package installation state.
if uci -q show openvpn >/dev/null 2>&1; then
    ovpn_active_rules="$(openvpn_active_wan_1194_rules)"
    if openvpn_any_server_enabled; then
        if [ -n "$ovpn_active_rules" ]; then
            ok "OpenVPN: enabled server has an active WAN 1194 rule"
        else
            warn "OpenVPN: a server is enabled but no active WAN 1194 rule was found; verify its listen port and ingress policy"
        fi
    elif [ -n "$ovpn_active_rules" ]; then
        fail "OpenVPN: all servers are disabled but WAN 1194 ACCEPT rule(s) remain active: $(echo "$ovpn_active_rules" | tr '\n' ' ')"
    else
        ok "OpenVPN: servers are disabled and no active WAN 1194 rule remains"
    fi
else
    ok "OpenVPN: not installed"
fi

# ImmortalWrt's vlmcsd service listens on all local addresses. The upstream
# internet_access option additionally creates a src='*' TCP/1688 accept rule.
if uci -q get vlmcsd.config >/dev/null 2>&1; then
    if [ "$(uci -q get vlmcsd.config.enabled)" = "1" ]; then
        if pidof vlmcsd >/dev/null 2>&1; then
            ok "VLMCS: service enabled and running"
        else
            fail "VLMCS: enabled but daemon is not running"
        fi
        if [ "$(uci -q get vlmcsd.config.internet_access)" = "1" ]; then
            warn "VLMCS: internet_access=1 exposes TCP/1688 through the package's wildcard firewall rule"
        else
            ok "VLMCS: internet_access is disabled; no package-managed WAN exposure requested"
        fi
        if [ "$(uci -q get vlmcsd.config.auto_activate)" = "1" ]; then
            ok "VLMCS: upstream auto_activate option is enabled"
        fi
    else
        ok "VLMCS: disabled"
    fi
    if uci -q get vlmcsd.config.autoactivate >/dev/null 2>&1; then
        warn "VLMCS: obsolete autoactivate option is present; upstream uses auto_activate"
    fi
else
    ok "VLMCS: not installed"
fi

# OpenClash owns dnsmasq redirection while enabled and must revert it when stopped.
if uci -q get openclash.config >/dev/null 2>&1; then
    oc_overlay_free=$(openclash_overlay_free_kb)
    oc_overlay_total=$(openclash_overlay_total_kb)
    oc_geodata_kb=$(openclash_geodata_kb)
    oc_auto_geodata=$(openclash_auto_geodata_enabled)
    oc_ui_overlay_kb=$(openclash_path_kb /overlay/upper/usr/share/openclash/ui)
    if [ "$oc_geodata_kb" -gt 0 ]; then
        if [ "$oc_overlay_free" -lt 4096 ]; then
            fail "OpenClash: GeoIP/GeoSite/ASN/CHNR data use ${oc_geodata_kb} KiB and overlay free is only ${oc_overlay_free} KiB"
        else
            warn "OpenClash: GeoIP/GeoSite/ASN/CHNR data use ${oc_geodata_kb} KiB on overlay; monitor free space before updates"
        fi
    fi
    if [ -n "$oc_auto_geodata" ]; then
        if [ "$oc_overlay_total" -gt 0 ] && [ "$oc_overlay_total" -lt 65536 ]; then
            warn "OpenClash: ${oc_auto_geodata} enabled on ${oc_overlay_total} KiB overlay can refill flash"
        else
            warn "OpenClash: ${oc_auto_geodata} enabled; ensure overlay has enough free space"
        fi
    fi
    if [ "$oc_ui_overlay_kb" -gt 0 ]; then
        warn "OpenClash: dashboard UI files occupy ${oc_ui_overlay_kb} KiB in overlay; prefer baking plugin into firmware"
    fi
    dns_port=$(uci -q get openclash.config.dns_port)
    [ -n "$dns_port" ] || dns_port=7874
    dns_server=$(uci -q get dhcp.@dnsmasq[0].server)
    redirect_mode=$(uci -q get openclash.config.enable_redirect_dns)
    [ -n "$redirect_mode" ] || redirect_mode=1
    openclash_mode=$(uci -q get openclash.config.operation_mode)
    [ -n "$openclash_mode" ] || openclash_mode=$(uci -q get openclash.config.en_mode)
    if [ "$(uci -q get openclash.config.enable)" = "1" ]; then
        if pidof clash >/dev/null 2>&1; then
            ok "OpenClash: core process running"
        else
            fail "OpenClash: enabled but core process is not running"
        fi
        if zerotier_enabled &&
           [ "$(uci -q get openclash.config.router_self_proxy)" = "1" ]; then
            if [ -x /usr/bin/ax6-openclash-zerotier-bypass ] &&
               openclash_zerotier_bypass_match; then
                ok "OpenClash: ZeroTier dynamic self-proxy bypass matches daemon ports"
            else
                fail "OpenClash: router self proxy intercepts ZeroTier without a matching dynamic bypass"
            fi
        elif openclash_zerotier_bypass_absent; then
            ok "OpenClash: no stale ZeroTier self-proxy bypass rules"
        else
            fail "OpenClash: stale ZeroTier self-proxy bypass rules remain"
        fi
        case "$redirect_mode" in
            1)
                if echo "$dns_server" | grep -q "127.0.0.1#${dns_port}"; then
                    ok "OpenClash: dnsmasq redirect points to ${dns_port}"
                else
                    fail "OpenClash: Dnsmasq Redirect mode does not point to ${dns_port}"
                fi
                [ "$(uci -q get dhcp.@dnsmasq[0].noresolv)" = "1" ] ||
                    warn "OpenClash: Dnsmasq Redirect mode normally requires noresolv=1"
                warn "OpenClash: Dnsmasq Redirect mode makes DNS depend on the local core; monitor core availability"
                ;;
            2)
                if nft list chain inet fw4 openclash_dns_redirect 2>/dev/null |
                   grep -q 'OpenClash DNS Hijack'; then
                    ok "OpenClash: Firewall Redirect nftables DNS rule is active"
                else
                    fail "OpenClash: Firewall Redirect mode is enabled but its nftables DNS rule is missing"
                fi
                echo "$dns_server" | grep -q "127.0.0.1#${dns_port}" &&
                    warn "OpenClash: Firewall Redirect mode still has a dnsmasq redirect to ${dns_port}"
                ;;
            0)
                ok "OpenClash: DNS hijacking is disabled"
                echo "$dns_server" | grep -q "127.0.0.1#${dns_port}" &&
                    warn "OpenClash: DNS hijacking is disabled but dnsmasq still redirects to ${dns_port}"
                ;;
            *)
                warn "OpenClash: unknown DNS redirect mode ${redirect_mode}; verify DNS ownership"
                ;;
        esac
        case "$openclash_mode" in
            fake-ip*)
                if [ "$(uci -q get openclash.config.store_fakeip)" = "1" ]; then
                    ok "OpenClash: fake-ip cache persistence enabled"
                else
                    warn "OpenClash: fake-ip mode should enable store_fakeip=1 to survive core restarts"
                fi
                if [ "$(uci -q get openclash.config.enable_custom_dns)" = "1" ]; then
                    if [ "$(openclash_dns_group_count nameserver)" -gt 0 ]; then
                        ok "OpenClash: custom DNS nameserver group is configured"
                    else
                        fail "OpenClash: enable_custom_dns=1 but no nameserver DNS servers are configured"
                    fi
                    if [ "$(uci -q get openclash.config.ipv6_enable)" != "1" ] &&
                       [ "$(uci -q get openclash.config.ipv6_dns)" != "1" ]; then
                        if [ "$(openclash_dns_group_count default)" -gt 0 ]; then
                            openclash_default_dns_ipv6_conflict
                        else
                            warn "OpenClash: IPv6 DNS is disabled but no default DNS group is configured; subscription default-nameserver may keep IPv6 entries"
                        fi
                    fi
                else
                    warn "OpenClash: custom DNS disabled; subscription DNS owns nameserver/default-nameserver"
                fi
                ;;
        esac
    else
        if echo "$dns_server" | grep -q "127.0.0.1#${dns_port}"; then
            fail "OpenClash: disabled but dnsmasq still points to ${dns_port}"
        else
            ok "OpenClash: disabled and dnsmasq redirect reverted"
        fi
    fi
else
    ok "OpenClash: not installed"
fi

if [ "$QUIET" -eq 0 ]; then
    echo ""
    echo "=== Summary: PASS=$PASS WARN=$WARN FAIL=$FAIL ==="
    if [ "$FAIL" -eq 0 ]; then
        echo "Status: no definite configuration faults"
    else
        echo "Status: definite configuration faults found"
    fi
fi

exit "$FAIL"
