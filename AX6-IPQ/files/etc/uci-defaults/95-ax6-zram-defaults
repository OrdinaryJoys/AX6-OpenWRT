#!/bin/sh
# Keep explicit AX6 ZRAM policy without overwriting an existing administrator choice.

changed=0

if [ -z "$(uci -q get system.@system[0].zram_size_mb)" ]; then
    uci -q set system.@system[0].zram_size_mb='256'
    changed=1
fi

if [ -z "$(uci -q get system.@system[0].zram_comp_algo)" ]; then
    uci -q set system.@system[0].zram_comp_algo='zstd'
    changed=1
fi

[ "$changed" -eq 0 ] || uci -q commit system

exit 0
