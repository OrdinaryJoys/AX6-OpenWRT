#!/bin/sh

# Run after luci-app-openvpn-server's "openvpn" uci-default. The upstream
# package creates firewall.openvpn as enabled even though openvpn.myvpn is
# disabled by default, so reconcile the canonical rule after both packages
# have installed their defaults.

OPENVPN_BIN="${OPENVPN_BIN:-/usr/sbin/openvpn}"
[ -x "$OPENVPN_BIN" ] || exit 0

network_changed=0
firewall_changed=0

# Migrate only the exact anonymous skeleton emitted by the former AX6 default.
# A firewall zone references the UCI interface section name, not option name.
for section in $(uci -q show network 2>/dev/null |
	sed -n "s/^network\.\([^=]*\)\.name='OpenVPN'$/\1/p"); do
	[ "$(uci -q get "network.${section}" 2>/dev/null)" = interface ] || continue
	[ "$(uci -q get "network.${section}.device" 2>/dev/null)" = tun0 ] || continue
	[ "$(uci -q get "network.${section}.proto" 2>/dev/null)" = none ] || continue
	[ "$(uci -q get "network.${section}.auto" 2>/dev/null)" = 0 ] || continue
	uci -q delete "network.${section}"
	network_changed=1
	logger -t ax6-openvpn "Removed legacy anonymous OpenVPN interface skeleton"
done

# Remove the other exact legacy server scaffolding shipped by the old AX6
# image only while its matching package-default server is disabled. These
# predicates intentionally do not match a user-configured OpenVPN interface.
if [ "$(uci -q get openvpn.myvpn.enabled 2>/dev/null || echo 0)" != 1 ]; then
	if [ "$(uci -q get network.myvpn 2>/dev/null)" = interface ] &&
	   [ "$(uci -q get network.myvpn.proto 2>/dev/null)" = openvpn ] &&
	   [ "$(uci -q get network.myvpn.enabled 2>/dev/null)" = 0 ] &&
	   [ "$(uci -q get network.myvpn.ovpnproto 2>/dev/null)" = tcp-server ] &&
	   [ "$(uci -q get network.myvpn.port 2>/dev/null)" = 1194 ] &&
	   [ "$(uci -q get network.myvpn.ddns 2>/dev/null)" = example.com ] &&
	   [ "$(uci -q get network.myvpn.server 2>/dev/null)" = '10.8.0.0 255.255.255.0' ]; then
		uci -q delete network.myvpn
		network_changed=1
		logger -t ax6-openvpn "Removed disabled legacy OpenVPN netifd server interface"
	fi
	if [ "$(uci -q get network.vpn0 2>/dev/null)" = interface ] &&
	   [ "$(uci -q get network.vpn0.ifname 2>/dev/null)" = tun0 ] &&
	   [ "$(uci -q get network.vpn0.proto 2>/dev/null)" = none ] &&
	   [ "$(uci -q show network.vpn0 2>/dev/null | wc -l | tr -d ' ')" = 3 ]; then
		uci -q delete network.vpn0
		network_changed=1
		logger -t ax6-openvpn "Removed disabled legacy vpn0 interface"
	fi
fi

if ! uci -q get network.OpenVPN >/dev/null 2>&1; then
	uci -q set network.OpenVPN='interface'
	uci -q set network.OpenVPN.device='tun0'
	uci -q set network.OpenVPN.proto='none'
	uci -q set network.OpenVPN.auto='0'
	network_changed=1
	logger -t ax6-openvpn "Created OpenVPN network interface (tun0, disabled)"
fi

lan_zone="$(uci -q show firewall 2>/dev/null |
	sed -n "s/^firewall\.\([^=]*\)\.name='lan'$/\1/p" | head -n 1)"
if [ -n "$lan_zone" ]; then
	lan_networks="$(uci -q get "firewall.${lan_zone}.network" 2>/dev/null || true)"
	case " $lan_networks " in
		*' OpenVPN '*) ;;
		*)
			uci -q add_list "firewall.${lan_zone}.network=OpenVPN"
			firewall_changed=1
			logger -t ax6-openvpn "Added OpenVPN to lan zone"
			;;
	esac
fi

if ! uci -q get firewall.openvpn >/dev/null 2>&1; then
	uci -q set firewall.openvpn='rule'
	uci -q set firewall.openvpn.name='openvpn'
	uci -q set firewall.openvpn.src='wan'
	uci -q set firewall.openvpn.proto='tcp udp'
	uci -q set firewall.openvpn.dest_port='1194'
	uci -q set firewall.openvpn.target='ACCEPT'
	firewall_changed=1
fi

if [ "$(uci -q get openvpn.myvpn.enabled 2>/dev/null || echo 0)" != '1' ]; then
	uci -q set firewall.openvpn.enabled='0'
	firewall_changed=1
	logger -t ax6-openvpn "Disabled WAN OpenVPN rule while the server is disabled"
fi

# Remove only the exact legacy rule generated by the previous AX6 default.
for section in $(uci -q show firewall 2>/dev/null |
	sed -n 's/^firewall\.\([^=]*\)=rule$/\1/p'); do
	[ "$(uci -q get "firewall.${section}.name" 2>/dev/null)" = 'Allow-OpenVPN' ] || continue
	[ "$(uci -q get "firewall.${section}.src" 2>/dev/null)" = 'wan' ] || continue
	[ "$(uci -q get "firewall.${section}.dest_port" 2>/dev/null)" = '1194' ] || continue
	[ "$(uci -q get "firewall.${section}.proto" 2>/dev/null)" = 'tcp' ] || continue
	[ "$(uci -q get "firewall.${section}.target" 2>/dev/null)" = 'ACCEPT' ] || continue
	[ "$(uci -q get "firewall.${section}.enabled" 2>/dev/null)" = '0' ] || continue
	uci -q delete "firewall.${section}"
	firewall_changed=1
	logger -t ax6-openvpn "Removed legacy duplicate Allow-OpenVPN rule"
done

if [ "$(uci -q get openvpn.myvpn.enabled 2>/dev/null || echo 0)" != 1 ]; then
	if [ "$(uci -q get firewall.vpn 2>/dev/null)" = zone ] &&
	   [ "$(uci -q get firewall.vpn.name 2>/dev/null)" = vpn ] &&
	   [ "$(uci -q get firewall.vpn.input 2>/dev/null)" = ACCEPT ] &&
	   [ "$(uci -q get firewall.vpn.forward 2>/dev/null)" = ACCEPT ] &&
	   [ "$(uci -q get firewall.vpn.output 2>/dev/null)" = ACCEPT ] &&
	   [ "$(uci -q get firewall.vpn.masq 2>/dev/null)" = 1 ] &&
	   [ "$(uci -q get firewall.vpn.network 2>/dev/null)" = vpn0 ]; then
		uci -q delete firewall.vpn
		firewall_changed=1
		logger -t ax6-openvpn "Removed disabled legacy vpn0 firewall zone"
	fi
	for legacy in 'vpntowan:vpn:wan' 'vpntolan:vpn:lan' 'lantovpn:lan:vpn'; do
		section="${legacy%%:*}"
		rest="${legacy#*:}"
		src="${rest%%:*}"
		dest="${rest#*:}"
		[ "$(uci -q get "firewall.${section}" 2>/dev/null)" = forwarding ] || continue
		[ "$(uci -q get "firewall.${section}.src" 2>/dev/null)" = "$src" ] || continue
		[ "$(uci -q get "firewall.${section}.dest" 2>/dev/null)" = "$dest" ] || continue
		uci -q delete "firewall.${section}"
		firewall_changed=1
		logger -t ax6-openvpn "Removed disabled legacy ${section} forwarding"
	done
fi

[ "$network_changed" -eq 0 ] || uci commit network
[ "$firewall_changed" -eq 0 ] || uci commit firewall

exit 0
