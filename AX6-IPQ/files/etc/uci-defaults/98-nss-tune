#!/bin/sh
# NSS ECM handles hardware offload — conflicting flow-offload modules must be blocked.
# Uses defense-in-depth: kernel module blacklist + UCI runtime disable.
# Runs once via uci-defaults on first boot.

# ===================================================================
# Layer 1: 内核模块级别 — 静态 blacklist 文件随镜像安装,这里只清理已加载模块
# ===================================================================
rmmod ipt_FLOWOFFLOAD 2>/dev/null || true
rmmod nft_flow_offload 2>/dev/null || true
rmmod nf_flow_table 2>/dev/null || true

# ===================================================================
# Layer 2: UCI 配置级别 — firewall4 flow offload 必须关闭
# ===================================================================

# firewall 级别
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall

# ===================================================================
# Layer 3: ECM offload — layered host/physical policy (P0-C, 2026-07-26).
#          EDMA v1 on IPQ807x does not implement hardware checksum,
#          so Linux checksum/GSO/GRO offloads corrupt host-terminated
#          traffic (LuCI/SSH/DNS) → packet loss → TCP retransmission →
#          management UI unresponsiveness.
#
#          disable_offloads=1 enables the policy engine.
#          offload_host_ifaces="br-lan"     → hard-disable offloads (host-path)
#          offload_physical_policy="report" → physical ports logged, not force-disabled
#            (forwarded traffic uses NSS/PPE; per-feature A/B pending)
#          disable_gro_list=1 → upstream default, avoids GRO fraglist/UDP issues.
#
#          Unified policy: ECM init, reload, and hotplug all call the
#          same disable_offload() entry point with UCI-driven decisions.
# ===================================================================
uci -q set ecm.general.disable_offloads='1'
uci -q set ecm.general.disable_gro_list='1'
uci -q set ecm.general.offload_host_ifaces='br-lan'
uci -q set ecm.general.offload_physical_policy='report'
uci commit ecm

exit 0
