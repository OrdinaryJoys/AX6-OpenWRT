#!/bin/sh
# AX6 WiFi max performance — IPQ8074 4x4 AX
# Override country: echo CN > /etc/config/ax6_wifi_country && reboot
# Runs once via uci-defaults on first boot.

COUNTRY_FILE="/etc/config/ax6_wifi_country"
COUNTRY="US"
if [ -r "$COUNTRY_FILE" ]; then
    COUNTRY="$(head -n 1 "$COUNTRY_FILE" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
fi
[ -n "$COUNTRY" ] || COUNTRY="US"

RADIOS="$(uci show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-device/{print $2}')"

for radio in $RADIOS; do
    band="$(uci -q get "wireless.${radio}.band")"

    uci -q set "wireless.${radio}.country=$COUNTRY"
    uci -q set "wireless.${radio}.disabled=0"

    uci -q set "wireless.${radio}.cell_density=0"
    uci -q set "wireless.${radio}.legacy_rates=1"
    # Keep 20/40 coexistence active. HE40 may fall back to HE20 when 2.4G is busy.
    uci -q delete "wireless.${radio}.noscan"
    uci -q set "wireless.${radio}.beacon_int=100"
    uci -q set "wireless.${radio}.dtim_period=1"

    # Keep broadly supported beamforming; leave MU-EDCA, BSS color and spatial
    # reuse to ath11k/hostapd so they can adapt to the active channel.
    uci -q set "wireless.${radio}.he_su_beamformer=1"
    uci -q set "wireless.${radio}.he_su_beamformee=1"
    uci -q set "wireless.${radio}.he_mu_beamformer=1"
    uci -q set "wireless.${radio}.mu_beamformer=1"
    uci -q set "wireless.${radio}.he_twt_required=0"
    uci -q delete "wireless.${radio}.he_mu_edca"
    uci -q delete "wireless.${radio}.he_bss_color"
    uci -q delete "wireless.${radio}.he_spr_sr_control"
    uci -q delete "wireless.${radio}.he_spr_non_srg_obss_pd_max_offset"
    uci -q delete "wireless.${radio}.he_default_pe_duration"

    case "$band" in
        5g)
            uci -q set "wireless.${radio}.htmode=HE80"
            cur_chan="$(uci -q get "wireless.${radio}.channel")"
            if [ -z "$cur_chan" ] || [ "$cur_chan" = "auto" ]; then
                uci -q set "wireless.${radio}.channel=36"
            fi
            uci -q set "wireless.${radio}.tx_antenna=15"
            uci -q set "wireless.${radio}.rx_antenna=15"
            ;;
        2g)
            uci -q set "wireless.${radio}.htmode=HE40"
            uci -q set "wireless.${radio}.channel=auto"
            uci -q set "wireless.${radio}.tx_antenna=3"
            uci -q set "wireless.${radio}.rx_antenna=3"
            ;;
    esac

done

for iface in $(uci show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-iface/{print $2}'); do
    # WMM is required for 802.11n/ac/ax. Keep low-ACK disconnect disabled for
    # long-range and sleeping IoT clients, but do not force isolation-like
    # proxy/multicast behavior or PMF/U-APSD on every SSID.
    uci -q set "wireless.${iface}.disassoc_low_ack=0"
    uci -q set "wireless.${iface}.wmm=1"
    uci -q set "wireless.${iface}.isolate=0"
    uci -q delete "wireless.${iface}.uapsd"
    uci -q delete "wireless.${iface}.proxy_arp"
    uci -q delete "wireless.${iface}.multicast_to_unicast"
done

if uci -q commit wireless; then
    logger -t ax6-wifi-tune "WiFi configured: country=$COUNTRY, radios=$(echo "$RADIOS" | wc -w)"
else
    logger -t ax6-wifi-tune "ERROR: uci commit wireless failed — WiFi may use board defaults (CN)"
fi

# ath11k firmware applies built-in regdb on init — must set iw reg BEFORE wifi starts.
# On subsequent boots, the init script below runs at START=10.
# On this first boot (procd already scanned rc.d), we call iw reg set directly.
iw reg set "$COUNTRY" 2>/dev/null

if [ ! -f /etc/init.d/ax6-wifi-regdom ]; then
    cat > /etc/init.d/ax6-wifi-regdom << 'INIT'
#!/bin/sh /etc/rc.common
# AX6: set iw reg domain before wifi starts (ath11k firmware reads regdb at init)
START=10
start() {
    RADIO=$(uci -q show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-device/{print $2; exit}')
    COUNTRY=$(uci -q get "wireless.${RADIO}.country" 2>/dev/null)
    [ -z "$COUNTRY" ] && COUNTRY="US"
    iw reg set "$COUNTRY" 2>/dev/null
}
INIT
    chmod +x /etc/init.d/ax6-wifi-regdom
    /etc/init.d/ax6-wifi-regdom enable 2>/dev/null
fi

exit 0
