#!/bin/sh
# Keep the local bridge aligned with qca-nss-ecm's offload policy.
#
# qca-nss-ecm's bundled hotplug script intentionally handles physical devices.
# br-lan is a virtual bridge used by router-local LuCI/SSH/DNS traffic, so apply
# the same packaged policy helper when that bridge is created.

[ "$ACTION" = "add" ] || exit 0
[ "$INTERFACE" = "br-lan" ] || exit 0

INC="/lib/netifd/offload/disable_offloads.sh"
. "$INC" 2>/dev/null || {
	logger -t "100-disable_offloads_br_lan" -p user.error "missing include script $INC"
	exit 1
}

disable_offload "$INTERFACE"

exit 0
