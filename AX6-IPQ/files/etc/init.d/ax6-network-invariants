#!/bin/sh /etc/rc.common
# Apply IPv4 router invariants after netifd has created the initial interfaces.

# shellcheck disable=SC2034
START=95

start() {
    /usr/sbin/ax6-network-invariants --all

    # qca-nss-ecm applies this policy during its earlier startup, but qca-nss-dp
    # and netifd can recreate or retune netdev features afterwards. Reapply the
    # packaged helper after interfaces and NSS drivers have settled. Its
    # parameterless path includes configured virtual host interfaces, so each
    # netdev is processed once in this pass.
    if [ -r /lib/netifd/offload/disable_offloads.sh ]; then
        # shellcheck disable=SC1091
        . /lib/netifd/offload/disable_offloads.sh
        disable_offload
    else
        logger -t ax6-network-invariants -p user.error \
            "missing /lib/netifd/offload/disable_offloads.sh"
    fi
}

reload() {
    start
}
