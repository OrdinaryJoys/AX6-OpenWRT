#!/bin/sh /etc/rc.common
# AX6 Boot Guard — enforce only settings that conflict directly with NSS.
# Scenario-dependent WiFi, VLAN, firewall and service policy is audit-only.
# START=12: before network(20) / firewall so they read the corrected NSS UCI.
# shellcheck disable=SC2034  # START/STOP read by /etc/rc.common framework
START=12

start() {
    # 1. packet_steering 必须 =0 (NSS 硬件卸载需要)
    cur=$(uci -q get network.globals.packet_steering 2>/dev/null)
    [ "$cur" != "0" ] && uci set network.globals.packet_steering='0' && CHANGED=1

    # 2. firewall4 software/hardware flow offload conflicts with NSS ECM.
    for option in flow_offloading flow_offloading_hw; do
        [ "$(uci -q get "firewall.@defaults[0].${option}")" != "0" ] &&
            uci -q set "firewall.@defaults[0].${option}=0" && FIREWALL_CHANGED=1
    done

    # 3. ECM: IPQ807x has no hardware checksum — software offloads (GRO/GSO/
    # checksum) on br-lan corrupt host-terminated traffic (LuCI, SSH, DNS).
    # disable_offloads=1 keeps ECM loaded while NSS forwarding acceleration is
    # fully preserved. disable_gro_list=1 is the upstream safe default (UDP
    # fraglist → DNS/DHCP breakage).
    for ecm_opt in disable_offloads:1 disable_gro_list:1; do
        key="${ecm_opt%%:*}"
        expected="${ecm_opt##*:}"
        [ "$(uci -q get "ecm.general.${key}")" != "$expected" ] &&
            uci -q set "ecm.general.${key}=${expected}" && ECM_CHANGED=1
    done

    # 4. Remove obsolete device-level copies. netifd/firewall only consume the
    # global packet_steering and firewall defaults above.
    for d in $(uci -q show network 2>/dev/null | awk -F'[.=]' '/=device$/{print $2}'); do
        for option in packet_steering flow_offloading flow_offloading_hw; do
            if uci -q get "network.${d}.${option}" >/dev/null 2>&1; then
                uci -q delete "network.${d}.${option}" && CHANGED=1
            fi
        done
    done

    # 5. Only commit settings owned by the NSS data path.
    if [ "${CHANGED:-0}" = "1" ]; then
        uci commit network
        logger -t ax6-boot-guard "Corrected NSS-incompatible settings (likely from sysupgrade with preserved config)"
    fi
    if [ "${FIREWALL_CHANGED:-0}" = "1" ]; then
        uci commit firewall
        logger -t ax6-boot-guard "Disabled firewall flow offload so NSS ECM remains the only offload owner"
    fi
    if [ "${ECM_CHANGED:-0}" = "1" ]; then
        uci commit ecm
        logger -t ax6-boot-guard "Enforced ecm disable_offloads=1 + disable_gro_list=1 (IPQ807x HW checksum absent)"
    fi
}
