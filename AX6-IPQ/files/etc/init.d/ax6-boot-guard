#!/bin/sh /etc/rc.common
# Enforce only NSS-owned settings, before network/firewall consume the UCI.
# shellcheck shell=ash
# shellcheck disable=SC2034 # Read by rc.common.
START=12

guard_error() {
    logger -t ax6-boot-guard -p user.err "$*" || :
}

guard_package() {
    local package="$1" snapshot pending section rules option key expected current
    local changed=0 status=0 rc d

    # Never commit someone else's pending edits or invent missing sections.
    pending=$(uci -q changes "$package") || return "$?"
    if [ -n "$pending" ]; then
        guard_error "$package: pending UCI edits; left untouched"
        return 1
    fi
    uci -q show "$package" >/dev/null || return "$?"
    case "$package" in
        network) section=network.globals; rules=packet_steering:0 ;;
        firewall)
            section='firewall.@defaults[0]'
            rules='flow_offloading:0 flow_offloading_hw:0'
            ;;
        ecm)
            section=ecm.general
            rules='disable_offloads:1 disable_gro_list:1 offload_host_ifaces:br-lan offload_physical_policy:report'
            ;;
        *) return 64 ;;
    esac
    uci -q get "$section" >/dev/null || return "$?"
    # Snapshot success distinguishes absent optional keys from failed reads.
    snapshot=$(uci -q show "$section") || return "$?"
    section=${snapshot%%=*}
    for option in $rules; do
        key="$section.${option%%:*}"
        expected="${option#*:}"
        if printf '%s\n' "$snapshot" | awk -v p="$key=" 'index($0,p)==1 {found=1} END {exit !found}'; then
            current=$(uci -q get "$key") || {
                rc=$?; [ "$status" -ne 0 ] || status=$rc; continue;
            }
            [ "$current" != "$expected" ] || continue
        fi
        if uci -q set "$key=$expected"; then
            changed=1
            current=$(uci -q get "$key") && [ "$current" = "$expected" ] || {
                rc=$?; [ "$status" -ne 0 ] || status=$rc;
            }
        else
            rc=$?; [ "$status" -ne 0 ] || status=$rc
        fi
    done

    if [ "$package" = network ]; then
        snapshot=$(uci -q show network) || {
            rc=$?; [ "$status" -ne 0 ] || status=$rc; return "$status";
        }
        for d in $(printf '%s\n' "$snapshot" | awk -F'[.=]' '/=device$/{print $2}'); do
            for option in packet_steering flow_offloading flow_offloading_hw; do
                key="network.${d}.${option}"
                if printf '%s\n' "$snapshot" | awk -v p="$key=" 'index($0,p)==1 {found=1} END {exit !found}'; then
                    if uci -q delete "$key"; then
                        changed=1
                        current=$(uci -q show "network.$d") &&
                            ! printf '%s\n' "$current" | awk -v p="$key=" 'index($0,p)==1 {found=1} END {exit !found}' || {
                            rc=$?; [ "$status" -ne 0 ] || status=$rc;
                        }
                    else
                        rc=$?; [ "$status" -ne 0 ] || status=$rc
                    fi
                fi
            done
        done
    fi
    [ "$status" -eq 0 ] || return "$status"
    [ "$changed" -eq 1 ] || return 0
    uci -q commit "$package" || return "$?"
    pending=$(uci -q changes "$package") || return "$?"
    [ -z "$pending" ] || return 1
    for option in $rules; do
        current=$(uci -q get "$section.${option%%:*}") || return "$?"
        [ "$current" = "${option#*:}" ] || return 1
    done
    if [ "$package" = network ]; then
        snapshot=$(uci -q show network) || return "$?"
        for d in $(printf '%s\n' "$snapshot" | awk -F'[.=]' '/=device$/{print $2}'); do
            for option in packet_steering flow_offloading flow_offloading_hw; do
                ! printf '%s\n' "$snapshot" | awk -v p="network.${d}.${option}=" \
                    'index($0,p)==1 {found=1} END {exit !found}' || return 1
            done
        done
    fi
    logger -t ax6-boot-guard "$package: NSS-owned settings committed and verified" || :
}

start() {
    local package status=0 rc
    for package in network firewall ecm; do
        guard_package "$package" || {
            rc=$?
            guard_error "$package: enforcement failed ($rc); no reload/rollback attempted"
            [ "$status" -ne 0 ] || status=$rc
        }
    done
    return "$status"
}
