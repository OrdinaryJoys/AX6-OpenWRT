#!/bin/sh /etc/rc.common
# shellcheck disable=2034,3043
#
# AX6 NSS IRQ/RPS policy override.
#
# The upstream qualcommax script sets RPS to all CPUs for all interfaces.
# On AX6 with NSS firmware offload, the NSS N2H path handles its own
# per-core distribution (NSS RPS at firmware level), and Linux RPS on
# the same queues adds overhead without benefit.
#
# This override gates RPS behind a UCI flag. Default: OFF.
# The manual ax6-irq-affinity tool (/usr/sbin/ax6-irq-affinity) remains
# available for benchmark A/B without changing boot policy.
#
# Fixes C-05 from AX6 cross-audit 2026-07-26.

START=99

start() {
	local rps_enabled

	# Gate RPS behind an explicit UCI opt-in.
	# When NSS ECM handles offload (the default production config),
	# NSS firmware RPS distributes N2H traffic. Linux RPS is only
	# useful for benchmarking the non-offloaded fallback path.
	rps_enabled=$(uci -q get network.globals.rps 2>/dev/null)
	case "$rps_enabled" in
		1|true|yes|enable|on) ;;
		*)
			logger -t set-irq-affinity \
				"NSS ECM mode: Linux RPS/XPS skipped (set network.globals.rps=1 to enable)"
			return 0
			;;
	esac

	# ---- RPS explicitly enabled: run the qualcommax default policy ----
	local flow_cnt sock_flow_entries cpu_mask

	flow_cnt=8192
	sock_flow_entries=65535
	cpu_mask="f"  # 4-core IPQ807x

	for eth in $(jsonfilter -i "/etc/board.json" -e "@.network[*].device"); do
		[ -d "/sys/class/net/$eth" ] || continue
		for i in "/sys/class/net/$eth"/queues/rx-*/rps_cpus; do
			[ -w "$i" ] && echo "$cpu_mask" > "$i"
		done
		for i in "/sys/class/net/$eth"/queues/rx-*/rps_flow_cnt; do
			[ -w "$i" ] && echo "$flow_cnt" > "$i"
		done
		for i in "/sys/class/net/$eth"/queues/tx-*/xps_cpus; do
			[ -w "$i" ] && echo "$cpu_mask" > "$i"
		done
	done

	[ -w "/proc/sys/net/core/rps_sock_flow_entries" ] && \
		echo "$sock_flow_entries" > "/proc/sys/net/core/rps_sock_flow_entries"

	logger -t set-irq-affinity \
		"Linux RPS/XPS applied (cpu_mask=$cpu_mask, flow_cnt=$flow_cnt)"
}
