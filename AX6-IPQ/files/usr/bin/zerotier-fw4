#!/bin/sh

FW_PATH="${ZEROTIER_FW_PATH:-/var/run/zerotier-one/_fw4}"
[ -d "$FW_PATH" ] || mkdir -p "$FW_PATH"

append_rule_once() {
	file="$1"
	chain="$2"
	rule="$3"
	grep -Fqx "$rule" "$file" 2>/dev/null && return 0
	printf '%s\n' "$rule" >> "$file"
	nft insert rule inet fw4 "$chain" "$rule" 2>/dev/null || true
}

drop_stale_port_rules() {
	file="$1"
	tmp="${file}.$$"
	grep -Fv "th dport" "$file" 2>/dev/null > "$tmp" || true
	mv "$tmp" "$file"
}

while getopts "i:s" arg; do
	case "$arg" in
	i)
		iface="$OPTARG"
		[ -n "$iface" ] || continue

		network_id="$(zerotier-cli -j listnetworks | jsonfilter -qe "@[@.portDeviceName=\"$iface\"].nwid")"
		[ -n "$network_id" ] || continue

		network_cfg="$(uci show "zerotier" | awk "/$network_id/ && !found {split(\$0, conf, /[.=]/); print conf[2]; found=1}")"
		[ -n "$network_cfg" ] || continue

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_input)" = "1" ]; then
			rule="iifname $iface counter accept comment \"!fw4: Accept ZeroTier input $iface\""
			append_rule_once "$FW_PATH/input.nft" input "$rule"
		fi

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_forward)" = "1" ]; then
			fwd_ifaces="$(uci -q get zerotier."$network_cfg".fw_forward_ifaces)"
			rule="iifname $iface counter accept comment \"!fw4: Accept ZeroTier input forward $iface\""
			[ -n "$fwd_ifaces" ] && rule="oifname { ${fwd_ifaces// /, } } $rule"
			append_rule_once "$FW_PATH/forward.nft" forward "$rule"

			rule="oifname $iface counter accept comment \"!fw4: Accept ZeroTier output forward $iface\""
			[ -n "$fwd_ifaces" ] && rule="iifname { ${fwd_ifaces// /, } } $rule"
			append_rule_once "$FW_PATH/forward.nft" forward "$rule"
		fi

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_masq)" = "1" ]; then
			masq_ifaces="$(uci -q get zerotier."$network_cfg".fw_masq_ifaces)"
			rule="oifname $iface counter masquerade comment \"!fw4: Masquerade ZeroTier traffic $iface\""
			[ -n "$masq_ifaces" ] && rule="iifname { ${masq_ifaces// /, } } $rule"
			append_rule_once "$FW_PATH/srcnat.nft" srcnat "$rule"
		fi
		;;
	s)
		[ "$(uci -q get zerotier.global.fw_allow_input)" = "1" ] || continue

		# Wait until zerotier-cli responds (daemon may still be starting).
		cli_wait=0
		while [ "$cli_wait" -lt 60 ]; do
			if zerotier-cli info >/dev/null 2>&1; then
				break
			fi
			sleep 2s
			cli_wait=$((cli_wait + 2))
		done
		if [ "$cli_wait" -ge 60 ]; then
			logger -t zerotier-fw4 "zerotier-cli unresponsive after 60s — giving up"
			continue
		fi

		# Per ZeroTier official documentation, only the primary port
		# (default 9993, UDP + TCP) must be open in the firewall.
		# @.config.settings.tertiaryPort (and other ports listed in @.config.settings.listeningOn[*]) are for STUN/ICE NAT
		# traversal and do NOT need inbound rules. Tracking ephemeral
		# ports is inherently unreliable across reboots.
		primary_port="$(zerotier-cli -j info 2>/dev/null | jsonfilter -qe "@.config.settings.primaryPort" 2>/dev/null)"
		[ -n "$primary_port" ] || primary_port=9993

		drop_stale_port_rules "$FW_PATH/input.nft"
		rule="meta l4proto { udp, tcp } th dport $primary_port counter accept comment \"!fw4: Accept ZeroTier input $primary_port (primaryPort)\""
		append_rule_once "$FW_PATH/input.nft" input "$rule"
		fw4 reload >/dev/null 2>&1 || true
		;;
	*)
		echo "Usage: $0 -i <interface> | -s"
		echo "  -i <interface> : Generate rules for the specified interface"
		echo "  -s             : Generate rules for the zerotier service primary port"
		exit 1
		;;
	esac
done
