#!/bin/sh

RECONCILER="${RECONCILER:-/usr/sbin/ax6-zerotier-reconcile}"
requested=0

while getopts "i:s" arg; do
	case "$arg" in
		i)
			[ -n "$OPTARG" ] || continue
			requested=1
			;;
		s) requested=1 ;;
		*)
			echo "Usage: $0 -i <interface> | -s"
			exit 1
			;;
	esac
done

[ "$requested" -eq 1 ] || {
	echo "Usage: $0 -i <interface> | -s"
	exit 1
}

[ -x "$RECONCILER" ] || {
	logger -t zerotier-fw4 "missing $RECONCILER" 2>/dev/null || true
	exit 1
}

exec "$RECONCILER" --once
