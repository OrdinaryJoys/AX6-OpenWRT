#!/bin/sh

FW_PATH="${FW_PATH:-/var/run/zerotier-one/_fw4}"
[ -d "$FW_PATH" ] || mkdir -p "$FW_PATH"

nft_iface_set() {
	printf '%s\n' "$1" | awk '{$1=$1; gsub(/ /, ", "); print}'
}

append_input_rule_once() {
	file="$1"
	rule="$2"
	grep -Fqx "$rule" "$file" 2>/dev/null && return 0
	echo "$rule" >> "$file"
	nft insert rule inet fw4 "input $rule" 2>/dev/null || true
}

drop_stale_port_rules() {
	file="$1"
	tmp="${file}.$$"
	grep -Fv "th dport" "$file" 2>/dev/null > "$tmp" || true
	mv "$tmp" "$file"
}

while getopts "i:s" arg; do
	case "$arg" in
	i)
		iface="$OPTARG"
		[ -n "$iface" ] || continue

		network_id="$(zerotier-cli -j listnetworks | jsonfilter -qe "@[@.portDeviceName=\"$iface\"].nwid")"
		[ -n "$network_id" ] || continue

		network_cfg="$(uci show "zerotier" | awk "/$network_id/ && !found {split(\$0, conf, /[.=]/); print conf[2]; found=1}")"
		[ -n "$network_cfg" ] || continue

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_input)" = "1" ]; then
			grep -q "$iface" "$FW_PATH/input.nft" 2>"/dev/null" && continue
			rule="iifname $iface counter accept comment \"!fw4: Accept ZeroTier input $iface\""
			echo "$rule" >> "$FW_PATH/input.nft"
			nft insert rule inet fw4 input "$rule"
		fi

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_forward)" = "1" ]; then
			grep -q "$iface" "$FW_PATH/forward.nft" 2>"/dev/null" && continue
			fwd_ifaces="$(uci -q get zerotier."$network_cfg".fw_forward_ifaces)"
			fwd_iface_set="$(nft_iface_set "$fwd_ifaces")"
			rule="iifname $iface counter accept comment \"!fw4: Accept ZeroTier input forward $iface\""
			[ -n "$fwd_iface_set" ] && rule="oifname { $fwd_iface_set } $rule"
			echo "$rule" >> "$FW_PATH/forward.nft"
			nft insert rule inet fw4 forward "$rule"

			rule="oifname $iface counter accept comment \"!fw4: Accept ZeroTier output forward $iface\""
			[ -n "$fwd_iface_set" ] && rule="iifname { $fwd_iface_set } $rule"
			echo "$rule" >> "$FW_PATH/forward.nft"
			nft insert rule inet fw4 forward "$rule"
		fi

		if [ "$(uci -q get zerotier."$network_cfg".fw_allow_masq)" = "1" ]; then
			grep -q "$iface" "$FW_PATH/srcnat.nft" 2>"/dev/null" && continue
			masq_ifaces="$(uci -q get zerotier."$network_cfg".fw_masq_ifaces)"
			masq_iface_set="$(nft_iface_set "$masq_ifaces")"
			rule="oifname $iface counter masquerade comment \"!fw4: Masquerade ZeroTier traffic $iface\""
			[ -n "$masq_iface_set" ] && rule="iifname { $masq_iface_set } $rule"
			echo "$rule" >> "$FW_PATH/srcnat.nft"
			nft insert rule inet fw4 srcnat "$rule"
		fi
		;;
	s)
		[ "$(uci -q get zerotier.global.fw_allow_input)" = "1" ] || continue

		# Wait until zerotier-cli responds (daemon may still be starting).
		cli_wait=0
		while [ "$cli_wait" -lt 60 ]; do
			if zerotier-cli info >/dev/null 2>&1; then
				break
			fi
			sleep 2s
			cli_wait=$((cli_wait + 2))
		done
		if [ "$cli_wait" -ge 60 ]; then
			logger -t zerotier-fw4 "zerotier-cli unresponsive after 60s — giving up"
			continue
		fi

		drop_stale_port_rules "$FW_PATH/input.nft"
		zerotier_info="$(zerotier-cli -j info 2>/dev/null | jsonfilter -qe '@.config.settings' 2>/dev/null)"
		[ -n "$zerotier_info" ] || continue
		for port_name in primaryPort secondaryPort; do
			port="$(printf '%s\n' "$zerotier_info" | jsonfilter -qe "@.${port_name}" 2>/dev/null)"
			[ -n "$port" ] || continue
			protocols="udp"
			[ "$port_name" = "primaryPort" ] && protocols="udp, tcp"
			rule="meta l4proto { $protocols } th dport $port counter accept comment \"!fw4: Accept ZeroTier input $port ($port_name)\""
			append_input_rule_once "$FW_PATH/input.nft" "$rule"
		done
		fw4 reload >/dev/null 2>&1 || true
		;;
	*)
		echo "Usage: $0 -i <interface> | -s"
		echo "  -i <interface> : Generate rules for the specified interface"
		echo "  -s             : Generate service-port rules"
		exit 1
		;;
	esac
done
