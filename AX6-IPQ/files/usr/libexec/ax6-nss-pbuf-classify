#!/bin/sh

# Classify the active NSS N2H/pbuf values against an OpenWrt memory profile.
# Arguments: profile memtotal extra high wifi [kernel_page_size]
# Output is a single pipe-delimited record:
#   status|label|expected_extra|expected_high|expected_wifi|observed_total

profile=${1:-auto}
memtotal=${2:-}
extra=${3:-}
high=${4:-}
wifi=${5:-}
page_size=${6:-4096}

case "$profile" in
    off*|false*|disable*|0)
        printf 'disabled|||||\n'
        exit 0
        ;;
    auto)
        case "$memtotal" in
            ''|*[!0-9]*)
                printf 'invalid-memory|||||\n'
                exit 0
                ;;
        esac
        if [ "$memtotal" -gt 512000 ]; then
            expected_extra=10000000
            expected_high=72512
            expected_wifi=36864
            label=1GB
        elif [ "$memtotal" -le 256000 ]; then
            expected_extra=4000000
            expected_high=16384
            expected_wifi=8192
            label=256MB
        else
            expected_extra=8000000
            expected_high=32768
            expected_wifi=16384
            label=512MB
        fi
        ;;
    1024|1g*)
        expected_extra=10000000
        expected_high=72512
        expected_wifi=36864
        label=1GB
        ;;
    512|512m*)
        expected_extra=8000000
        expected_high=32768
        expected_wifi=16384
        label=512MB
        ;;
    256|256m*)
        expected_extra=4000000
        expected_high=16384
        expected_wifi=8192
        label=256MB
        ;;
    *)
        printf 'invalid-profile|||||\n'
        exit 0
        ;;
esac

case "$page_size" in
    ''|*[!0-9]*|0)
        printf 'invalid-page-size|||||\n'
        exit 0
        ;;
esac

# The NSS driver rounds the one-shot extra pool allocation to PAGE_SIZE.
expected_extra=$(((expected_extra + page_size - 1) / page_size * page_size))

case "$extra:$high:$wifi" in
    *[!0-9:]*|:*|*::*|*:)
        printf 'invalid-values|%s|%s|%s|%s|\n' \
            "$label" "$expected_extra" "$expected_high" "$expected_wifi"
        exit 0
        ;;
esac

total=$((high + wifi))
if [ "$extra" -eq "$expected_extra" ] &&
   [ "$high" -eq "$expected_high" ] &&
   [ "$wifi" -eq "$expected_wifi" ]; then
    status=ok
else
    status=fail
fi

printf '%s|%s|%s|%s|%s|%s\n' \
    "$status" "$label" "$expected_extra" "$expected_high" "$expected_wifi" "$total"
