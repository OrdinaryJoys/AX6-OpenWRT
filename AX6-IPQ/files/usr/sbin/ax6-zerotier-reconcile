#!/bin/sh

FW_PATH="${FW_PATH:-/var/run/zerotier-one/_fw4}"
INPUT_FILE="${INPUT_FILE:-$FW_PATH/input.nft}"
FORWARD_FILE="${FORWARD_FILE:-$FW_PATH/forward.nft}"
SRCNAT_FILE="${SRCNAT_FILE:-$FW_PATH/srcnat.nft}"
STATE_FILE="${STATE_FILE:-/var/run/ax6-zerotier-reconcile.state}"
LOCK_FILE="${LOCK_FILE:-/var/lock/ax6-zerotier-reconcile.lock}"
BYPASS_HELPER="${BYPASS_HELPER:-/usr/bin/ax6-openclash-zerotier-bypass}"
INTERVAL="${INTERVAL:-30}"
STABLE_DELAY="${STABLE_DELAY:-2}"
DRY_RUN=0
LOCK_HELD=0
WORK_FILES=

log_change() {
	logger -t ax6-zerotier-reconcile "$1" 2>/dev/null || true
}

log_error() {
	logger -t ax6-zerotier-reconcile -p user.error "$1" 2>/dev/null || true
}

valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_iface() {
	case "$1" in
		''|*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac
	[ "${#1}" -le 15 ]
}

nft_iface_set() {
	result=
	for iface in $1; do
		valid_iface "$iface" || return 1
		if [ -n "$result" ]; then
			result="$result, \"$iface\""
		else
			result="\"$iface\""
		fi
	done
	printf '%s\n' "$result"
}

read_settings() {
	info="$(zerotier-cli -j info 2>/dev/null |
		jsonfilter -qe '@.config.settings' 2>/dev/null)"
	[ -n "$info" ] || return 1

	primary="$(printf '%s\n' "$info" |
		jsonfilter -qe '@.primaryPort' 2>/dev/null)"
	secondary="$(printf '%s\n' "$info" |
		jsonfilter -qe '@.secondaryPort' 2>/dev/null)"
	mapping="$(printf '%s\n' "$info" |
		jsonfilter -qe '@.portMappingEnabled' 2>/dev/null)"
	valid_port "$primary" && valid_port "$secondary" || return 1

	tertiary=0
	case "$mapping" in
		true|1)
			tertiary="$(printf '%s\n' "$info" |
				jsonfilter -qe '@.tertiaryPort' 2>/dev/null)"
			valid_port "$tertiary" || return 1
			;;
	esac
	printf '%s %s %s\n' "$primary" "$secondary" "$tertiary"
}

read_stable_settings() {
	first="$(read_settings)" || return 1
	previous="$(cat "$STATE_FILE" 2>/dev/null || true)"
	if [ "$first" != "$previous" ]; then
		sleep "$STABLE_DELAY"
		second="$(read_settings)" || return 1
		[ "$first" = "$second" ] || {
			log_error "ZeroTier ports changed while being sampled; retaining last valid rules"
			return 1
		}
	fi
	printf '%s\n' "$first"
}

acquire_lock() {
	[ "${AX6_ZT_LOCK_HELD:-0}" = 1 ] && return 0
	command -v lock >/dev/null 2>&1 || {
		log_error "required /bin/lock utility is unavailable"
		return 1
	}
	mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || return 1
	lock "$LOCK_FILE" || return 1
	LOCK_HELD=1
}

release_lock() {
	[ "$LOCK_HELD" -eq 1 ] || return 0
	lock -u "$LOCK_FILE" >/dev/null 2>&1 || true
	LOCK_HELD=0
}

cleanup() {
	for file in $WORK_FILES; do
		rm -f "$file"
	done
	release_lock
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

is_owned_rule() {
	case "$1" in
		*'comment "!fw4: Accept ZeroTier input '*|\
		*'comment "!fw4: Accept ZeroTier output forward '*|\
		*'comment "!fw4: Masquerade ZeroTier traffic '*) return 0 ;;
	esac
	return 1
}

strip_owned_rules() {
	file="$1"
	if [ -r "$file" ]; then
		while IFS= read -r rule || [ -n "$rule" ]; do
			is_owned_rule "$rule" || printf '%s\n' "$rule"
		done < "$file"
	fi
}

append_service_rules() {
	file="$1"
	primary="$2"
	secondary="$3"
	tertiary="$4"
	printf '%s\n' \
		"udp dport $primary counter accept comment \"!fw4: Accept ZeroTier input $primary (primaryPort)\"" \
		"udp dport $secondary counter accept comment \"!fw4: Accept ZeroTier input $secondary (secondaryPort)\"" \
		>> "$file"
	[ "$tertiary" -gt 0 ] && printf '%s\n' \
		"udp dport $tertiary counter accept comment \"!fw4: Accept ZeroTier input $tertiary (tertiaryPort)\"" \
		>> "$file"
}

zerotier_sections() {
	uci -q show zerotier 2>/dev/null |
		awk -F'[.=]' '/=(network|zerotier)$/ { print $2 }'
}

zerotier_enabled() {
	if uci -q get zerotier.global >/dev/null 2>&1; then
		[ "$(uci -q get zerotier.global.enabled 2>/dev/null)" = 1 ]
		return
	fi

	for section in $(uci -q show zerotier 2>/dev/null |
		awk -F'[.=]' '/=zerotier$/ { print $2 }'); do
		[ "$(uci -q get "zerotier.${section}.enabled" 2>/dev/null)" = 1 ] && return 0
	done
	return 1
}

zerotier_service_input_enabled() {
	if uci -q get zerotier.global >/dev/null 2>&1; then
		[ "$(uci -q get zerotier.global.fw_allow_input 2>/dev/null)" = 1 ]
		return
	fi

	for section in $(uci -q show zerotier 2>/dev/null |
		awk -F'[.=]' '/=zerotier$/ { print $2 }'); do
		[ "$(uci -q get "zerotier.${section}.enabled" 2>/dev/null)" = 1 ] || continue
		[ "$(uci -q get "zerotier.${section}.fw_allow_input" 2>/dev/null)" = 1 ] && return 0
	done
	return 1
}

network_section() {
	nwid="$1"
	for candidate in $(zerotier_sections); do
		configured_nwid="$(uci -q get "zerotier.${candidate}.id" 2>/dev/null || true)"
		if [ "$configured_nwid" = "$nwid" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
		for configured_nwid in $(uci -q get "zerotier.${candidate}.join" 2>/dev/null || true); do
			[ "$configured_nwid" = "$nwid" ] || continue
			printf '%s\n' "$candidate"
			return 0
		done
	done
	return 1
}

append_network_rules() {
	input="$1"
	forward="$2"
	srcnat="$3"
	networks="$(zerotier-cli -j listnetworks 2>/dev/null)" || return 1
	ifaces="$(printf '%s\n' "$networks" |
		jsonfilter -qe '@[*].portDeviceName' 2>/dev/null || true)"

	for iface in $ifaces; do
		valid_iface "$iface" || return 1
		network_id="$(printf '%s\n' "$networks" |
			jsonfilter -qe "@[@.portDeviceName=\"$iface\"].nwid" 2>/dev/null)"
		[ -n "$network_id" ] || return 1
		section="$(network_section "$network_id")"
		[ -n "$section" ] || continue
		[ "$(uci -q get "zerotier.${section}.enabled" 2>/dev/null)" = 0 ] && continue

		if [ "$(uci -q get "zerotier.${section}.fw_allow_input" 2>/dev/null)" = 1 ]; then
			printf '%s\n' \
				"iifname \"$iface\" counter accept comment \"!fw4: Accept ZeroTier input $iface\"" \
				>> "$input"
		fi

		if [ "$(uci -q get "zerotier.${section}.fw_allow_forward" 2>/dev/null)" = 1 ]; then
			fwd_ifaces="$(uci -q get "zerotier.${section}.fw_forward_ifaces" 2>/dev/null || true)"
			fwd_set="$(nft_iface_set "$fwd_ifaces")" || return 1
			prefix=
			[ -z "$fwd_set" ] || prefix="oifname { $fwd_set } "
			printf '%s\n' \
				"${prefix}iifname \"$iface\" counter accept comment \"!fw4: Accept ZeroTier input forward $iface\"" \
				>> "$forward"
			prefix=
			[ -z "$fwd_set" ] || prefix="iifname { $fwd_set } "
			printf '%s\n' \
				"${prefix}oifname \"$iface\" counter accept comment \"!fw4: Accept ZeroTier output forward $iface\"" \
				>> "$forward"
		fi

		if [ "$(uci -q get "zerotier.${section}.fw_allow_masq" 2>/dev/null)" = 1 ]; then
			masq_ifaces="$(uci -q get "zerotier.${section}.fw_masq_ifaces" 2>/dev/null || true)"
			masq_set="$(nft_iface_set "$masq_ifaces")" || return 1
			prefix=
			[ -z "$masq_set" ] || prefix="iifname { $masq_set } "
			printf '%s\n' \
				"${prefix}oifname \"$iface\" counter masquerade comment \"!fw4: Masquerade ZeroTier traffic $iface\"" \
				>> "$srcnat"
		fi
	done
}

new_work_file() {
	NEW_WORK_FILE="$FW_PATH/$1.$$"
	: > "$NEW_WORK_FILE" || return 1
	WORK_FILES="$WORK_FILES $NEW_WORK_FILE"
}

render_desired_rules() {
	enabled="$1"
	primary="$2"
	secondary="$3"
	tertiary="$4"
	mkdir -p "$FW_PATH" || return 1

	new_work_file input.desired || return 1
	DESIRED_INPUT="$NEW_WORK_FILE"
	new_work_file forward.desired || return 1
	DESIRED_FORWARD="$NEW_WORK_FILE"
	new_work_file srcnat.desired || return 1
	DESIRED_SRCNAT="$NEW_WORK_FILE"
	strip_owned_rules "$INPUT_FILE" > "$DESIRED_INPUT"
	strip_owned_rules "$FORWARD_FILE" > "$DESIRED_FORWARD"
	strip_owned_rules "$SRCNAT_FILE" > "$DESIRED_SRCNAT"

	[ "$enabled" = 1 ] || return 0
	zerotier_service_input_enabled &&
		append_service_rules "$DESIRED_INPUT" "$primary" "$secondary" "$tertiary"
	append_network_rules "$DESIRED_INPUT" "$DESIRED_FORWARD" "$DESIRED_SRCNAT"
}

owned_rules() {
	while IFS= read -r rule || [ -n "$rule" ]; do
		is_owned_rule "$rule" && printf '%s\n' "$rule"
	done < "$1"
}

normalized_owned_rules() {
	owned_rules "$1" |
		sed -E \
			-e 's/^[[:space:]]+//' \
			-e 's/[[:space:]]+# handle [0-9]+$//' \
			-e 's/counter packets [0-9]+ bytes [0-9]+/counter/' |
		sort
}

rules_match() {
	[ "$(normalized_owned_rules "$1")" = "$(normalized_owned_rules "$2")" ]
}

append_chain_transaction() {
	chain="$1"
	live="$2"
	desired="$3"
	transaction="$4"

	owned_rules "$live" |
		awk '{ for (i = 1; i <= NF; i++) if ($i == "handle") print $(i + 1) }' |
		while IFS= read -r handle; do
			[ -n "$handle" ] && printf '%s\n' \
				"delete rule inet fw4 $chain handle $handle" >> "$transaction"
		done
	owned_rules "$desired" |
		while IFS= read -r rule; do
			printf '%s\n' "insert rule inet fw4 $chain $rule" >> "$transaction"
		done
}

install_desired_files() {
	chmod 0644 "$DESIRED_INPUT" "$DESIRED_FORWARD" "$DESIRED_SRCNAT" || return 1
	mv "$DESIRED_INPUT" "$INPUT_FILE" || return 1
	mv "$DESIRED_FORWARD" "$FORWARD_FILE" || return 1
	mv "$DESIRED_SRCNAT" "$SRCNAT_FILE" || return 1
}

sync_rules() {
	enabled="$1"
	primary="$2"
	secondary="$3"
	tertiary="$4"
	render_desired_rules "$enabled" "$primary" "$secondary" "$tertiary" || {
		log_error "cannot render a complete ZeroTier firewall state; retaining last valid rules"
		return 1
	}

	new_work_file input.live || return 1
	LIVE_INPUT="$NEW_WORK_FILE"
	new_work_file forward.live || return 1
	LIVE_FORWARD="$NEW_WORK_FILE"
	new_work_file srcnat.live || return 1
	LIVE_SRCNAT="$NEW_WORK_FILE"
	if ! nft -a list chain inet fw4 input > "$LIVE_INPUT" 2>/dev/null ||
	   ! nft -a list chain inet fw4 forward > "$LIVE_FORWARD" 2>/dev/null ||
	   ! nft -a list chain inet fw4 srcnat > "$LIVE_SRCNAT" 2>/dev/null; then
		[ "$DRY_RUN" -eq 1 ] || install_desired_files || return 1
		log_error "fw4 chains are unavailable; include files updated for the next reload"
		return 1
	fi

	files_exact=1
	cmp -s "$DESIRED_INPUT" "$INPUT_FILE" 2>/dev/null || files_exact=0
	cmp -s "$DESIRED_FORWARD" "$FORWARD_FILE" 2>/dev/null || files_exact=0
	cmp -s "$DESIRED_SRCNAT" "$SRCNAT_FILE" 2>/dev/null || files_exact=0
	live_exact=1
	rules_match "$DESIRED_INPUT" "$LIVE_INPUT" || live_exact=0
	rules_match "$DESIRED_FORWARD" "$LIVE_FORWARD" || live_exact=0
	rules_match "$DESIRED_SRCNAT" "$LIVE_SRCNAT" || live_exact=0

	if [ "$live_exact" -eq 1 ]; then
		if [ "$DRY_RUN" -eq 0 ] && [ "$files_exact" -eq 0 ]; then
			install_desired_files || return 1
			log_change "updated ZeroTier include files without changing live rules"
		elif [ "$DRY_RUN" -eq 1 ] && [ "$files_exact" -eq 0 ]; then
			log_change "dry-run: ZeroTier include files require reconciliation"
		fi
		return 0
	fi

	new_work_file firewall.transaction || return 1
	TRANSACTION="$NEW_WORK_FILE"
	append_chain_transaction input "$LIVE_INPUT" "$DESIRED_INPUT" "$TRANSACTION"
	append_chain_transaction forward "$LIVE_FORWARD" "$DESIRED_FORWARD" "$TRANSACTION"
	append_chain_transaction srcnat "$LIVE_SRCNAT" "$DESIRED_SRCNAT" "$TRANSACTION"

	if [ "$DRY_RUN" -eq 1 ]; then
		log_change "dry-run: ZeroTier firewall rules require reconciliation"
		return 0
	fi
	nft -c -f "$TRANSACTION" >/dev/null 2>&1 || {
		log_error "ZeroTier nft transaction validation failed"
		return 1
	}
	nft -f "$TRANSACTION" >/dev/null 2>&1 || {
		log_error "ZeroTier nft transaction failed"
		return 1
	}
	install_desired_files || return 1
	log_change "reconciled ZeroTier input, forward and srcnat rules without reloading firewall"
}

write_state() {
	[ "$DRY_RUN" -eq 0 ] || return 0
	tmp="${STATE_FILE}.tmp.$$"
	WORK_FILES="$WORK_FILES $tmp"
	printf '%s\n' "$1" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

sync_bypass() {
	[ -x "$BYPASS_HELPER" ] || return 0
	if [ "$DRY_RUN" -eq 1 ]; then
		AX6_ZT_LOCK_HELD=1 "$BYPASS_HELPER" --dry-run "$@"
	else
		AX6_ZT_LOCK_HELD=1 "$BYPASS_HELPER" "$@"
	fi
}

reconcile_once() {
	if ! zerotier_enabled; then
		acquire_lock || return 0
		status=0
		sync_rules 0 0 0 0 || status=1
		sync_bypass --cleanup || status=1
		[ "$DRY_RUN" -eq 1 ] || rm -f "$STATE_FILE"
		release_lock
		return "$status"
	fi

	acquire_lock || return 0
	settings="$(read_stable_settings)" || {
		log_error "cannot read stable ZeroTier daemon ports; retaining last valid rules"
		release_lock
		return 1
	}
	primary="${settings%% *}"
	remainder="${settings#* }"
	secondary="${remainder%% *}"
	tertiary="${remainder#* }"

	status=0
	sync_rules 1 "$primary" "$secondary" "$tertiary" || status=1
	sync_bypass --sync "$primary" "$secondary" "$tertiary" || status=1
	[ "$status" -ne 0 ] || write_state "$settings" || status=1
	release_lock
	return "$status"
}

usage() {
	echo "Usage: $0 [--once|--daemon|--dry-run]"
}

mode=once
case "${1:-}" in
	''|--once) mode=once ;;
	--daemon) mode=daemon ;;
	--dry-run) DRY_RUN=1; mode=once ;;
	-h|--help) usage; exit 0 ;;
	*) usage >&2; exit 64 ;;
esac

if [ "$mode" = daemon ]; then
	while :; do
		reconcile_once || true
		sleep "$INTERVAL"
	done
fi

reconcile_once
