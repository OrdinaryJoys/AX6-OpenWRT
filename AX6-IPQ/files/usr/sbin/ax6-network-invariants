#!/bin/sh
# shellcheck shell=ash

set -u

IPV4_CONF_ROOT="${AX6_IPV4_CONF_ROOT:-/proc/sys/net/ipv4/conf}"
status=0
[ -d "$IPV4_CONF_ROOT" ] || exit 1

failed() {
    [ "$status" -ne 0 ] || status="$1"
    printf '%s\n' "ax6-network-invariants: $2" >&2
}

apply_interface() {
    local interface="$1" directory setting name value file current rc
    directory="$IPV4_CONF_ROOT/$interface"

    [ "$interface" != "lo" ] || return 0
    [ -d "$directory" ] || return 0

    for setting in \
        send_redirects:0 \
        accept_redirects:0 \
        arp_ignore:1; do
        name="${setting%%:*}"
        value="${setting##*:}"
        file="$directory/$name"

        if ! current=$(cat "$file" 2>/dev/null); then
            [ -d "$directory" ] || return 0
            failed 1 "cannot read $file"
            continue
        fi
        [ "$current" != "$value" ] || continue
        if printf '%s\n' "$value" > "$file"; then
            if current=$(cat "$file" 2>/dev/null) && [ "$current" = "$value" ]; then
                continue
            fi
            rc=1
        else
            rc=$?
        fi
        [ -d "$directory" ] || return 0
        failed "$rc" "write/readback failed: $file"
    done
}

case "${1:-all}" in
    all|--all)
        for directory in "$IPV4_CONF_ROOT"/*; do
            [ -d "$directory" ] || continue
            apply_interface "${directory##*/}"
        done
        ;;
    -*)
        echo "usage: $0 [all|interface ...]" >&2
        exit 64
        ;;
    *)
        for interface in "$@"; do
            apply_interface "$interface"
        done
        ;;
esac
exit "$status"
